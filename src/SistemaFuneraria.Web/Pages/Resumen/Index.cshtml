@page
@model SistemaFuneraria.Web.Pages.Resumen.IndexModel
@{
    ViewData["Title"] = "Dashboard Operativo";
}

<!-- ========================================================
     ENCABEZADO DE PÁGINA (FIGMA CAPTURA 1 · SF-089)
     ======================================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div id="dashboardFechaKicker" class="text-uppercase fw-semibold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">
            @Model.FechaKicker
        </div>
        <h1 id="dashboardSaludo" class="h2 fw-bold text-dark mb-1">
            Buenos días, @Model.Saludo
        </h1>
        <p id="dashboardSubtitulo" class="text-muted mb-0 small">
            @Model.Subtitulo
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="/Ventas/Nueva" class="btn text-white px-3 py-2 rounded-3 fw-medium shadow-sm d-inline-flex align-items-center"
           style="background-color: var(--sf-primary-olive, #2D4224); border-color: var(--sf-primary-olive, #2D4224);">
            <i class="fa-solid fa-plus me-2" aria-hidden="true"></i> Nueva venta
        </a>
    </div>
</div>

<!-- Banner de Error con Reintento -->
<div id="dashboardErrorBanner" class="alert alert-danger d-none align-items-center justify-content-between gap-3 rounded-4 border-0 shadow-sm mb-4" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <span id="dashboardErrorText">No se pudo cargar la información del dashboard.</span>
    </div>
    <button type="button" id="btnReintentarDashboard" class="btn btn-sm btn-outline-danger rounded-3 fw-semibold">
        Reintentar
    </button>
</div>

<!-- ========================================================
     FILA 1: 4 TARJETAS KPI SUPERIORES (ROW G-3 MB-4)
     ======================================================== -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Ventas del mes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="bg-white rounded-4 shadow-sm border p-3 p-xl-4 h-100 d-flex flex-column justify-content-between position-relative sf-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <a href="/Contratos" class="small text-muted fw-semibold text-uppercase text-decoration-none stretched-link" style="letter-spacing: 0.04em;" aria-label="Ventas del mes, ir a contratos">
                    Ventas del mes
                </a>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 38px; height: 38px; background-color: #EBF5EB;">
                    <i class="fa-solid fa-file-invoice-dollar text-success fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1 placeholder-glow" id="kpiVentasMes">
                    <span class="placeholder col-6 rounded"></span>
                </div>
                <div class="text-muted small fw-medium d-flex align-items-center placeholder-glow" id="kpiVentasComparativa">
                    <span class="placeholder col-7 rounded"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Cobranza mensual -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="bg-white rounded-4 shadow-sm border p-3 p-xl-4 h-100 d-flex flex-column justify-content-between position-relative sf-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <a href="/Contratos" class="small text-muted fw-semibold text-uppercase text-decoration-none stretched-link" style="letter-spacing: 0.04em;" aria-label="Cobranza mensual, ir a contratos">
                    Cobranza mensual
                </a>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 38px; height: 38px; background-color: #E8F0FE;">
                    <i class="fa-solid fa-credit-card text-primary fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1 placeholder-glow" id="kpiCobranzaMensual">
                    <span class="placeholder col-6 rounded"></span>
                </div>
                <div class="text-muted small fw-medium d-flex align-items-center placeholder-glow" id="kpiCobranzaComparativa">
                    <span class="placeholder col-7 rounded"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Contratos activos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="bg-white rounded-4 shadow-sm border p-3 p-xl-4 h-100 d-flex flex-column justify-content-between position-relative sf-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <a href="/Contratos" class="small text-muted fw-semibold text-uppercase text-decoration-none stretched-link" style="letter-spacing: 0.04em;" aria-label="Contratos activos, ir a contratos">
                    Contratos activos
                </a>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 38px; height: 38px; background-color: #FEF7E6;">
                    <i class="fa-solid fa-users text-warning-emphasis fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1 placeholder-glow" id="kpiContratosActivos">
                    <span class="placeholder col-4 rounded"></span>
                </div>
                <div class="text-muted small fw-medium placeholder-glow" id="kpiContratosNuevos">
                    <span class="placeholder col-6 rounded"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 4: Pagos vencidos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="bg-white rounded-4 shadow-sm border p-3 p-xl-4 h-100 d-flex flex-column justify-content-between position-relative sf-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <a href="/Contratos?tab=vencidos" class="small text-muted fw-semibold text-uppercase text-decoration-none stretched-link" style="letter-spacing: 0.04em;" aria-label="Pagos vencidos, ir a contratos vencidos">
                    Pagos vencidos
                </a>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 38px; height: 38px; background-color: #FDF2F2;">
                    <i class="fa-solid fa-bell text-danger fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-danger sf-money mb-1 placeholder-glow" id="kpiPagosVencidos">
                    <span class="placeholder col-3 rounded"></span>
                </div>
                <div class="text-danger small fw-semibold placeholder-glow" id="kpiMontoPorRecuperar">
                    <span class="placeholder col-6 rounded"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     FILA 2: GRÁFICAS DE VENTAS/COBRANZA Y DISPONIBILIDAD
     ======================================================== -->
<div class="row g-4 mb-4">
    <!-- Columna Izquierda (col-lg-8): Ventas y cobranza -->
    <div class="col-12 col-lg-8">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <!-- Header de Tarjeta -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="h5 fw-bold text-dark mb-0">Ventas y cobranza</h2>
                    <p id="subtituloGrafica" class="text-muted small mb-0">Comportamiento de los últimos 6 meses.</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Leyenda de colores -->
                    <div class="d-flex align-items-center gap-3 small">
                        <span class="d-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #2D4224;"></span>
                            <span class="text-muted">Ventas</span>
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #C59D52;"></span>
                            <span class="text-muted">Cobranza</span>
                        </span>
                    </div>
                    <!-- Selector de rango -->
                    <select id="selectRangoGrafica" class="form-select form-select-sm rounded-3 w-auto border-secondary-subtle" aria-label="Seleccionar periodo de la gráfica">
                        <option value="6m" selected>Últimos 6 meses</option>
                        <option value="anio">Año @Model.AnioActual</option>
                    </select>
                </div>
            </div>

            <!-- Gráfica de Barras Dobles (CSS Responsivo con líneas guía dinámicas) -->
            <div class="sf-chart-container position-relative pt-3 pb-1" style="height: 240px;">
                <!-- Líneas Guía Horizontales del Eje Y -->
                <div id="yAxisGridLines" class="sf-grid-lines position-absolute w-100 h-100 top-0 start-0 d-flex flex-column justify-content-between pe-2" style="pointer-events: none; z-index: 1; padding-top: 12px; padding-bottom: 30px;">
                    <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
                        <span style="width: 48px;">--</span>
                        <div class="flex-grow-1 border-bottom border-light-subtle"></div>
                    </div>
                    <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
                        <span style="width: 48px;">--</span>
                        <div class="flex-grow-1 border-bottom border-light-subtle"></div>
                    </div>
                    <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
                        <span style="width: 48px;">--</span>
                        <div class="flex-grow-1 border-bottom border-light-subtle"></div>
                    </div>
                    <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
                        <span style="width: 48px;">--</span>
                        <div class="flex-grow-1 border-bottom border-light-subtle"></div>
                    </div>
                    <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
                        <span style="width: 48px;">--</span>
                        <div class="flex-grow-1 border-bottom border-light-subtle"></div>
                    </div>
                    <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
                        <span style="width: 48px;">$0k</span>
                        <div class="flex-grow-1 border-bottom border-secondary-subtle"></div>
                    </div>
                </div>

                <!-- Barras por mes alineadas con flexbox -->
                <div id="barsVentasCobranza" class="sf-bars-wrapper position-relative h-100 d-flex justify-content-around align-items-end ps-5 pe-2" style="z-index: 2;">
                    <div class="text-muted small align-self-center">Cargando gráfica...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Derecha (col-lg-4): Disponibilidad -->
    <div class="col-12 col-lg-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <!-- Header de Tarjeta -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="h5 fw-bold text-dark mb-0">Disponibilidad</h2>
                    <p class="text-muted small mb-0">Inventario por tipo de lote.</p>
                </div>
                <a href="/Catalogo" class="text-decoration-none small fw-semibold text-success d-inline-flex align-items-center">
                    Ver catálogo <i class="fa-solid fa-chevron-right ms-1 small" aria-hidden="true"></i>
                </a>
            </div>

            <!-- Gráfica de Dona Central (CSS Conic-Gradient con anillo) -->
            <div class="d-flex justify-content-center my-3">
                <div id="donutDisponibilidad" class="sf-donut-chart position-relative rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 140px; height: 140px; background: #E5E7EB;">
                    <!-- Agujero interior blanco de la dona -->
                    <div class="bg-white rounded-circle d-flex flex-column align-items-center justify-content-center shadow-sm"
                         style="width: 96px; height: 96px;">
                        <span class="display-6 fw-bold text-dark sf-money lh-1" id="kpiLotesDisponibles">--</span>
                        <span class="small text-muted" style="font-size: 0.75rem;">disponibles</span>
                    </div>
                </div>
            </div>

            <!-- Lista de Desglose de Lotes -->
            <div class="d-flex justify-content-around text-center border-top border-light-subtle pt-3 mb-3">
                <div>
                    <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #2D4224;"></span>
                        <span class="small text-muted" style="font-size: 0.75rem;">2 gavetas</span>
                    </div>
                    <div class="fw-bold sf-money text-dark fs-5" id="kpiLotes2">--</div>
                </div>
                <div class="border-start border-light-subtle"></div>
                <div>
                    <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #C59D52;"></span>
                        <span class="small text-muted" style="font-size: 0.75rem;">3 gavetas</span>
                    </div>
                    <div class="fw-bold sf-money text-dark fs-5" id="kpiLotes3">--</div>
                </div>
                <div class="border-start border-light-subtle"></div>
                <div>
                    <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                        <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #7D9B76;"></span>
                        <span class="small text-muted" style="font-size: 0.75rem;">4 gavetas</span>
                    </div>
                    <div class="fw-bold sf-money text-dark fs-5" id="kpiLotes4">--</div>
                </div>
            </div>

            <!-- Barra de Ocupación -->
            <div>
                <div class="progress rounded-pill mb-1" style="height: 8px; background-color: #EFECE6;">
                    <div id="barraOcupacion" class="progress-bar rounded-pill" role="progressbar"
                         style="width: 0%; background-color: #2D4224;"
                         aria-label="Porcentaje de ocupación del panteón"
                         aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center small text-muted">
                    <span>Ocupación total</span>
                    <span class="fw-bold text-dark" id="pctOcupacion">--</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     FILA 3: TARJETA INFERIOR "ACTIVIDAD RECIENTE"
     ======================================================== -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
    <!-- Header de Tarjeta -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h5 fw-bold text-dark mb-0">Actividad reciente</h2>
            <p class="text-muted small mb-0">Últimos movimientos registrados en el sistema.</p>
        </div>
        <a href="/Contratos" class="text-decoration-none small fw-semibold text-success d-inline-flex align-items-center">
            Ver todos <i class="fa-solid fa-chevron-right ms-1 small" aria-hidden="true"></i>
        </a>
    </div>

    <!-- Tabla de Movimientos Responsiva -->
    <div class="table-responsive">
        <table class="table align-middle mb-0" style="font-size: 0.9rem;">
            <thead class="table-light text-muted small">
                <tr>
                    <th scope="col" class="border-0 fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Cliente</th>
                    <th scope="col" class="border-0 fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Movimiento</th>
                    <th scope="col" class="border-0 fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Referencia</th>
                    <th scope="col" class="border-0 fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Importe</th>
                    <th scope="col" class="border-0 fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Estado</th>
                    <th scope="col" class="border-0 fw-semibold text-uppercase text-end" style="letter-spacing: 0.04em;">Fecha</th>
                </tr>
            </thead>
            <tbody id="tbodyActividadReciente">
                <tr>
                    <td colspan="6" class="py-4 text-center text-muted small placeholder-glow">
                        <span class="placeholder col-6 rounded"></span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Efecto hover suave en tarjetas KPI y barras de la gráfica */
    .sf-kpi-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .sf-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(45, 66, 36, 0.08) !important;
    }
    .sf-bar:hover {
        filter: brightness(1.15);
        cursor: pointer;
    }
</style>

@section Scripts {
    <script src="~/js/api/reportesApi.js" asp-append-version="true"></script>
    <script src="~/js/pages/resumenPage.js" asp-append-version="true"></script>
}
