    <div class="p-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 bg-light bg-opacity-50">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-list-check text-muted"></i>
            <span class="fw-bold text-dark small text-uppercase">Cuotas pendientes por cobrar</span>
        </div>
