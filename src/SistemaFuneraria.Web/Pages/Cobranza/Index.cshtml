                    <td>
                        <div class="fw-semibold text-dark">Roberto Méndez</div>
                        <div class="text-muted small">JC-C-118 · Jardín Central</div>
                    </td>
                    <td>Cuota 3 de 18</td>
                    <td class="text-end fw-bold formato-moneda">$7,523.51</td>
                    <td>18 nov. 2025</td>
                    <td>
                        <span class="badge badge-estado badge-al-corriente">Al corriente</span>
                    </td>
                    <td class="text-end pe-4">
                        <button type="button" 
                                class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 btn-abrir-cobro"
