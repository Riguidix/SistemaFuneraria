@page
@model SistemaFuneraria.Web.Pages.Cobranza.IndexModel
@{
    ViewData["Title"] = "Caja y Cobranza - Funeraria";
}

<!-- Encabezado de la Vista de Cobranza -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="funeraria-page-kicker">COBRANZA Y CAJA</span>
        <h1 class="funeraria-page-title">Caja y cobranza</h1>
        <p class="funeraria-page-subtitle">Recepción de pagos ordinarios, emisión de comprobantes foliados y control de corte diario.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" 
                class="btn btn-funeraria-primary d-inline-flex align-items-center gap-2 px-3 py-2" 
                data-bs-toggle="modal" 
                data-bs-target="#modalRegistrarPago"
                style="background-color: #2D4224 !important; border-color: #2D4224 !important; color: #FFFFFF !important;">
            <i class="fa-solid fa-receipt"></i>
            <span>Registrar pago de cuota</span>
        </button>
    </div>
</div>

<!-- Tarjetas KPI de Cobranza -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
            <span class="text-muted small fw-semibold text-uppercase">Cobranza del día</span>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="fs-2 fw-bold text-dark">$43,550.80</span>
                <span class="badge bg-success-subtle text-success rounded-pill small">+5 recibos</span>
            </div>
            <div class="small text-muted mt-1">Corte de caja abierto hoy 09:00 hrs</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
            <span class="text-muted small fw-semibold text-uppercase">Cuotas pendientes</span>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="fs-2 fw-bold text-dark">8 cuotas</span>
                <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill small">$69,681.28</span>
            </div>
            <div class="small text-muted mt-1">1 cuota en mora / pago vencido</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
            <span class="text-muted small fw-semibold text-uppercase">Próximo folio oficial</span>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="fs-2 fw-bold" style="color: #2D4224;">REC-2026-0043</span>
            </div>
            <div class="small text-muted mt-1">Sucursal Jardines del Valle · Ventanilla 1</div>
        </div>
    </div>
</div>

<!-- Alerta de Confirmación de Pago Dinámica -->
<div id="alertaPagoExitoso" class="alert alert-success d-none align-items-center justify-content-between rounded-4 shadow-sm mb-4 border-0" role="alert" style="background-color: #E8F5E9; color: #1B5E20;">
    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-circle-check fs-4 text-success"></i>
        <div>
            <strong id="textoPagoExitoso">¡Pago registrado exitosamente!</strong>
            <div class="small text-muted" id="subtextoPagoExitoso">Se ha emitido el comprobante foliado y actualizado el saldo de la cuota.</div>
        </div>
    </div>
    <button type="button" class="btn-close" onclick="document.getElementById('alertaPagoExitoso').classList.add('d-none');"></button>
</div>

<!-- Tabla de Cuotas y Cobranza en Ventanilla -->
