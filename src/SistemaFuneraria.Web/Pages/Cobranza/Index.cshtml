            </tbody>
        </table>
    </div>
</div>

<!-- Inclusión Modular del Modal de Cobranza (Ticket 036) -->
<partial name="_RegistrarPagoModal" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Manejador para precargar datos en el modal al dar clic en cualquier botón "Cobrar"
            document.querySelectorAll('.btn-abrir-cobro').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const folio = this.getAttribute('data-folio');
                    const cliente = this.getAttribute('data-cliente');
                    const cuota = this.getAttribute('data-cuota');

                    const inputFolio = document.getElementById('pagoFolioContrato');
                    const inputCliente = document.getElementById('pagoClienteTitular');
                    const inputCuota = document.getElementById('pagoCuotaLiquidar');

                    if (inputFolio) inputFolio.value = folio;
                    if (inputCliente) inputCliente.value = cliente;
                    if (inputCuota) inputCuota.value = cuota;

                    // Abrir modal mediante Bootstrap 5 API
                    const modalEl = document.getElementById('modalRegistrarPago');
                    if (modalEl) {
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modalInstance.show();
                    }
                });
            });

            // Acción del botón "Confirmar pago" en el modal
            const btnConfirmar = document.getElementById('btnConfirmarPagoModal');
            if (btnConfirmar) {
                btnConfirmar.addEventListener('click', function () {
                    const inputCliente = document.getElementById('pagoClienteTitular');
                    const clienteNombre = inputCliente ? inputCliente.value : 'Cliente';
                    const metodo = document.getElementById('pagoMetodoPago')?.value || 'efectivo';

                    // Cerrar el modal
                    const modalEl = document.getElementById('modalRegistrarPago');
                    if (modalEl) {
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                    }

                    // Mostrar alerta de éxito
                    const alerta = document.getElementById('alertaPagoExitoso');
                    const texto = document.getElementById('textoPagoExitoso');
                    const subtexto = document.getElementById('subtextoPagoExitoso');

                    if (alerta && texto) {
                        texto.textContent = `¡Pago de cuota de ${clienteNombre} registrado con éxito!`;
                        if (subtexto) {
                            subtexto.textContent = `Folio emitido: REC-2026-0043 · Método: ${metodo.toUpperCase()} · Comprobante listo para imprimir.`;
                        }
                        alerta.classList.remove('d-none');
                        alerta.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }
        });
    </script>
}
