@page
@model SistemaFuneraria.Web.Pages.Configuracion.IndexModel
@{
    ViewData["Title"] = "Configuración";
}

<!-- Estado de Acceso Restringido (403 Forbidden) -->
<div id="configAccesoRestringido" class="card border-0 shadow-sm rounded-4 p-5 text-center mb-4 d-none" role="alert">
    <div class="py-3">
        <i class="fa-solid fa-lock fa-2x text-danger mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark mb-2">Acceso restringido (403)</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 460px;">
            Tu rol actual no tiene permisos para administrar la configuración del sistema. Esta sección es exclusiva del rol <strong>Administrador</strong>.
        </p>
        <a id="btnVolver403Config" href="/Resumen" class="btn btn-funeraria-primary rounded-3 px-4">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver a mi inicio
        </a>
    </div>
</div>

<div id="configContenidoPrincipal">
<!-- ========================================================
     ENCABEZADO DE PÁGINA (FIGMA CAPTURA 12 · SF-092)
     ======================================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="text-uppercase fw-semibold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">
            ADMINISTRACIÓN
        </div>
        <h1 class="h2 fw-bold text-dark mb-1">
            Configuración
        </h1>
        <p class="text-muted mb-0 small">
            Preferencias generales y parámetros de la sucursal.
        </p>
    </div>
    <div>
        <button type="button" class="btn text-white px-4 py-2 rounded-3 fw-medium shadow-sm"
                id="btnGuardarCambios" style="background-color: var(--sf-primary-olive, #2D4224); border: none;">
            <span class="d-inline-flex align-items-center"><i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i> Guardar cambios</span>
        </button>
    </div>
</div>

<!-- Banner de Error Dinámico -->
<div id="alertaErrorConfig" class="alert alert-danger d-none rounded-4 shadow-sm mb-4 small" role="alert">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span id="mensajeErrorConfig">No fue posible cargar la configuración del sistema.</span>
        <button type="button" id="btnReintentarConfig" class="btn btn-sm btn-outline-danger rounded-3 fw-semibold">
            <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i> Reintentar
        </button>
    </div>
</div>

<!-- ========================================================
     LAYOUT PRINCIPAL DE 2 COLUMNAS (ROW G-4 MB-4)
     ======================================================== -->
<div class="row g-4 mb-4">
    <!-- Columna Izquierda (col-lg-3 col-md-4): Submenú Vertical de Secciones -->
    <div class="col-12 col-md-4 col-lg-3">
        <div class="bg-white rounded-4 shadow-sm border p-2">
            <nav class="nav flex-column gap-1" id="configNav" aria-label="Secciones de configuración">
                <!-- 1. Datos de la sucursal (ACTIVO INICIAL) -->
                <button type="button" class="nav-link w-100 text-start d-flex align-items-center sf-config-nav-item active border-0"
                        data-target="panel-datos-sucursal"
                        aria-current="page">
                    <i class="fa-solid fa-building me-2 sf-nav-icon text-success" aria-hidden="true"></i>
                    <span class="sf-nav-label">Datos de la sucursal</span>
                </button>

                <!-- 2. Usuarios y roles -->
                <button type="button" class="nav-link w-100 text-start d-flex align-items-center sf-config-nav-item border-0"
                        data-target="panel-usuarios-roles">
                    <i class="fa-solid fa-user-gear me-2 sf-nav-icon text-muted" aria-hidden="true"></i>
                    <span class="sf-nav-label">Usuarios y roles</span>
                </button>

                <!-- 3. Planes y tasas -->
                <button type="button" class="nav-link w-100 text-start d-flex align-items-center sf-config-nav-item border-0"
                        data-target="panel-planes-tasas">
                    <i class="fa-solid fa-percent me-2 sf-nav-icon text-muted" aria-hidden="true"></i>
                    <span class="sf-nav-label">Planes y tasas</span>
                </button>

                <!-- 4. Notificaciones -->
                <button type="button" class="nav-link w-100 text-start d-flex align-items-center sf-config-nav-item border-0"
                        data-target="panel-notificaciones">
                    <i class="fa-solid fa-bell me-2 sf-nav-icon text-muted" aria-hidden="true"></i>
                    <span class="sf-nav-label">Notificaciones</span>
                </button>

                <!-- 5. Integraciones -->
                <button type="button" class="nav-link w-100 text-start d-flex align-items-center sf-config-nav-item border-0"
                        data-target="panel-integraciones">
                    <i class="fa-solid fa-plug me-2 sf-nav-icon text-muted" aria-hidden="true"></i>
                    <span class="sf-nav-label">Integraciones</span>
                </button>
            </nav>
        </div>
    </div>

    <!-- Columna Derecha (col-lg-9 col-md-8): Contenido Dinámico de las 5 Secciones -->
    <div class="col-12 col-md-8 col-lg-9">
        <!-- ==========================================
             PANEL 1: DATOS DE LA SUCURSAL
             ========================================== -->
        <div class="sf-config-panel bg-white rounded-4 shadow-sm border p-4 p-md-5" id="panel-datos-sucursal">
            <div class="mb-4">
                <h2 class="h5 fw-bold text-dark mb-1">Datos de la sucursal</h2>
                <p class="text-muted small mb-0">Información que aparecerá en contratos y comprobantes.</p>
            </div>

            <form id="formDatosSucursal" method="post" onsubmit="return false;">
                <!-- Campo 1: Nombre comercial -->
                <div class="mb-3">
                    <label for="inputNombreComercial" class="form-label fw-medium small text-dark">Nombre comercial</label>
                    <input type="text" id="inputNombreComercial" class="form-control form-control-lg fs-6 rounded-3 border-secondary-subtle"
                           value="@Model.NombreComercial" placeholder="Nombre comercial de la funeraria">
                </div>

                <!-- Fila de 2 Columnas (Teléfono y Correo) -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label for="inputTelefono" class="form-label fw-medium small text-dark">Teléfono</label>
                        <input type="tel" id="inputTelefono" class="form-control form-control-lg fs-6 rounded-3 border-secondary-subtle"
                               value="@Model.Telefono" placeholder="55 0000 0000">
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="inputCorreo" class="form-label fw-medium small text-dark">Correo</label>
                        <input type="email" id="inputCorreo" class="form-control form-control-lg fs-6 rounded-3 border-secondary-subtle"
                               value="@Model.Correo" placeholder="contacto@empresa.mx">
                    </div>
                </div>

                <!-- Campo 3: Domicilio -->
                <div class="mb-3">
                    <label for="inputDomicilio" class="form-label fw-medium small text-dark">Domicilio</label>
                    <input type="text" id="inputDomicilio" class="form-control form-control-lg fs-6 rounded-3 border-secondary-subtle"
                           value="@Model.Domicilio" placeholder="Calle, número y colonia">
                </div>

                <!-- Fila de 2 Columnas (Ciudad y Código postal) -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label for="inputCiudad" class="form-label fw-medium small text-dark">Ciudad</label>
                        <input type="text" id="inputCiudad" class="form-control form-control-lg fs-6 rounded-3 border-secondary-subtle"
                               value="@Model.Ciudad" placeholder="Ciudad de operación">
                    </div>
                    <div class="col-12 col-md-6">
                        <label for="inputCodigoPostal" class="form-label fw-medium small text-dark">Código postal</label>
                        <input type="text" id="inputCodigoPostal" class="form-control form-control-lg fs-6 rounded-3 border-secondary-subtle"
                               value="@Model.CodigoPostal" placeholder="00000">
                    </div>
                </div>

                <!-- Línea Divisoria -->
                <hr class="my-4 text-muted-subtle">

                <!-- Sección: Switches Operativos de Automatización -->
                <div class="d-flex flex-column gap-3">
                    <!-- Switch 1: Recordatorios de pago -->
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #FAF8F5;">
                        <div class="pe-3">
                            <h3 class="h6 fw-bold text-dark mb-1">Recordatorios de pago</h3>
                            <p class="text-muted small mb-0">Enviar aviso 3 días antes de cada vencimiento.</p>
                        </div>
                        <div class="form-check form-switch fs-4 mb-0">
                            <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" id="switchRecordatorios" aria-label="Activar recordatorios de pago">
                        </div>
                    </div>

                    <!-- Switch 2: Resumen diario de caja -->
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #FAF8F5;">
                        <div class="pe-3">
                            <h3 class="h6 fw-bold text-dark mb-1">Resumen diario de caja</h3>
                            <p class="text-muted small mb-0">Enviar el corte al correo de administración.</p>
                        </div>
                        <div class="form-check form-switch fs-4 mb-0">
                            <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" id="switchResumenCaja" aria-label="Activar resumen diario de caja">
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- ==========================================
             PANEL 2: USUARIOS Y ROLES
             ========================================== -->
        <div class="sf-config-panel bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="panel-usuarios-roles">
            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-4">
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Usuarios y roles</h2>
                    <p class="text-muted small mb-0">Administra el acceso y los permisos de los colaboradores del sistema.</p>
                </div>
                <button type="button" id="btnNuevoUsuarioConfig" class="btn text-white px-3 py-2 rounded-3 fw-medium small d-inline-flex align-items-center shadow-sm"
                        style="background-color: var(--sf-primary-olive, #2D4224);">
                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i> Nuevo usuario
                </button>
            </div>

            <!-- Tabla de Usuarios -->
            <div class="table-responsive mb-4">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th scope="col" class="border-0 fw-semibold text-uppercase">Colaborador</th>
                            <th scope="col" class="border-0 fw-semibold text-uppercase">Rol</th>
                            <th scope="col" class="border-0 fw-semibold text-uppercase">Estado</th>
                            <th scope="col" class="border-0 fw-semibold text-uppercase">Acceso</th>
                            <th scope="col" class="border-0 fw-semibold text-uppercase text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyUsuariosConfig">
                        <tr id="filaCargandoUsuariosConfig">
                            <td colspan="5" class="text-center py-4 text-muted">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Cargando usuarios del sistema...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Card de Roles Informativa -->
            <div class="p-3 rounded-3 border" style="background-color: #FAF8F5;">
                <h3 class="h6 fw-bold text-dark mb-2 small text-uppercase" style="letter-spacing: 0.04em;">
                    <i class="fa-solid fa-shield-halved text-success me-1" aria-hidden="true"></i> Resumen de Permisos RBAC
                </h3>
                <div class="row g-2 small text-muted">
                    <div class="col-md-4">
                        <strong class="text-dark">Administrador:</strong> Acceso total, auditoría, configuración y gestión de usuarios.
                    </div>
                    <div class="col-md-4">
                        <strong class="text-dark">Vendedor:</strong> Catálogo de lotes, clientes, cotizaciones y registro de ventas.
                    </div>
                    <div class="col-md-4">
                        <strong class="text-dark">Cajero:</strong> Caja y cobranza, pagos de cuotas y corte del día.
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             PANEL 3: PLANES Y TASAS
             ========================================== -->
        <div class="sf-config-panel bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="panel-planes-tasas">
            <div class="mb-4">
                <h2 class="h5 fw-bold text-dark mb-1">Planes y tasas de financiamiento</h2>
                <p class="text-muted small mb-0">Parámetros oficiales del catálogo de precios, plazos y amortización francesa.</p>
            </div>

            <!-- Grid de Tarjetas de Planes -->
            <h3 class="h6 fw-bold text-dark small text-uppercase mb-3" style="letter-spacing: 0.04em;">Precios de Lista de Lotes</h3>
            <div class="row g-3 mb-4">
                @foreach (var plan in Model.PlanesLotes)
                {
                    <div class="col-12 col-md-4">
                        <div class="p-3 rounded-3 border h-100 d-flex flex-column justify-content-between" style="background-color: #FAF8F5;">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark">@plan.Nombre</span>
                                    <span class="badge bg-white text-dark border small">@plan.Gavetas gavetas</span>
                                </div>
                                <div class="display-6 fs-4 fw-bold sf-money text-success my-2">
                                    $@plan.PrecioLista.ToString("#,##0.00")
                                </div>
                            </div>
                            <div class="small text-muted pt-2 border-top">
                                Enganche: <span class="fw-semibold text-dark">@plan.EngancheSugerido</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Tabla de Plazos y Tasas -->
            <h3 class="h6 fw-bold text-dark small text-uppercase mb-3" style="letter-spacing: 0.04em;">Plazos y Tasas Vigentes</h3>
            <div class="table-responsive mb-4">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th scope="col" class="border-0 fw-semibold">Plazo</th>
                            <th scope="col" class="border-0 fw-semibold">Tasa Anual</th>
                            <th scope="col" class="border-0 fw-semibold">Esquema</th>
                            <th scope="col" class="border-0 fw-semibold text-end">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tasa in Model.TasasPlazos)
                        {
                            <tr>
                                <td class="py-2 fw-semibold text-dark">@tasa.Plazo</td>
                                <td class="py-2 sf-money fw-bold text-success">@tasa.TasaAnual.ToString("0.0")%</td>
                                <td class="py-2 text-muted small">@tasa.Tipo</td>
                                <td class="py-2 text-end">
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1">Vigente</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Regla de dominio fija -->
            <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #FAF8F5;">
                <div class="pe-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <h3 class="h6 fw-bold text-dark mb-0">Descuento por liquidación anticipada (10%)</h3>
                        <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small">Regla de dominio fija (RN-10)</span>
                    </div>
                    <p class="text-muted small mb-0">Aplica 10% de bonificación sobre intereses futuros no devengados en cierres anticipados.</p>
                </div>
                <div class="form-check form-switch fs-4 mb-0">
                    <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" checked disabled aria-disabled="true" aria-label="Descuento por liquidación anticipada del 10 por ciento (regla fija)">
                </div>
            </div>
        </div>

        <!-- ==========================================
             PANEL 4: NOTIFICACIONES (SOLO INFORMATIVO)
             ========================================== -->
        <div class="sf-config-panel bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="panel-notificaciones">
            <div class="mb-3">
                <h2 class="h5 fw-bold text-dark mb-1">Preferencias de notificación</h2>
                <p class="text-muted small mb-0">Canales y disparadores de avisos automáticos.</p>
            </div>

            <div class="alert alert-info rounded-3 small mb-4" role="status">
                <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>
                <strong>Solo informativo · Próximamente:</strong> La administración granular de canales y disparadores estará disponible en una próxima versión.
            </div>

            <!-- Canales de Envío -->
            <h3 class="h6 fw-bold text-dark small text-uppercase mb-3" style="letter-spacing: 0.04em;">Canales Planeados</h3>
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 border opacity-75" style="background-color: #FAF8F5;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-envelope text-primary fs-5" aria-hidden="true"></i>
                            <div>
                                <div class="fw-bold text-dark small">Correo electrónico</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Notificaciones transaccionales</div>
                            </div>
                        </div>
                        <div class="form-check form-switch fs-5 mb-0">
                            <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" checked disabled aria-disabled="true" aria-label="Canal correo electrónico (solo informativo)">
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 border opacity-75" style="background-color: #FAF8F5;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-brands fa-whatsapp text-success fs-5" aria-hidden="true"></i>
                            <div>
                                <div class="fw-bold text-dark small">WhatsApp / SMS</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Canal directo al titular</div>
                            </div>
                        </div>
                        <div class="form-check form-switch fs-5 mb-0">
                            <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" disabled aria-disabled="true" aria-label="Canal WhatsApp o SMS (solo informativo)">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Disparadores Automáticos -->
            <h3 class="h6 fw-bold text-dark small text-uppercase mb-3" style="letter-spacing: 0.04em;">Disparadores de Eventos</h3>
            <div class="d-flex flex-column gap-3 opacity-75">
                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #FAF8F5;">
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Confirmación de pago de cuota</h4>
                        <p class="text-muted small mb-0">Enviar comprobante digital al aplicar un pago en Caja.</p>
                    </div>
                    <div class="form-check form-switch fs-4 mb-0">
                        <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" checked disabled aria-disabled="true" aria-label="Confirmación de pago (solo informativo)">
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #FAF8F5;">
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Alerta preventiva de vencimiento</h4>
                        <p class="text-muted small mb-0">Recordatorio cordial 3 días antes de la fecha límite de pago.</p>
                    </div>
                    <div class="form-check form-switch fs-4 mb-0">
                        <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" checked disabled aria-disabled="true" aria-label="Alerta preventiva de vencimiento (solo informativo)">
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background-color: #FAF8F5;">
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Notificación de mora a cobranza</h4>
                        <p class="text-muted small mb-0">Alertar al módulo de Caja cuando un contrato alcanza 1 mensualidad vencida.</p>
                    </div>
                    <div class="form-check form-switch fs-4 mb-0">
                        <input class="form-check-input sf-switch-olive" type="checkbox" role="switch" checked disabled aria-disabled="true" aria-label="Notificación de mora (solo informativo)">
                    </div>
                </div>
            </div>
        </div>

        <!-- ==========================================
             PANEL 5: INTEGRACIONES (SOLO INFORMATIVO)
             ========================================== -->
        <div class="sf-config-panel bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="panel-integraciones">
            <div class="mb-3">
                <h2 class="h5 fw-bold text-dark mb-1">Integraciones y servicios externos</h2>
                <p class="text-muted small mb-0">Conectores planificados con pasarelas de pago, facturación electrónica y servicios externos.</p>
            </div>

            <div class="alert alert-info rounded-3 small mb-4" role="status">
                <i class="fa-solid fa-circle-info me-2" aria-hidden="true"></i>
                <strong>Solo informativo · Próximamente:</strong> Las integraciones externas y webhooks se habilitarán en futuras versiones.
            </div>

            <div class="row g-3">
                <!-- Integración 1: CFDI -->
                <div class="col-12 col-md-6">
                    <div class="p-4 rounded-3 border h-100 d-flex flex-column justify-content-between opacity-75" style="background-color: #FAF8F5;">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-file-invoice text-success fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6 fw-bold text-dark mb-0">Facturación CFDI 4.0</h3>
                                        <span class="small text-muted">Timbrado fiscal SAT</span>
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1">Próximamente</span>
                            </div>
                            <p class="small text-muted mb-0">Emisión automática de recibos y facturas fiscales por mensualidad.</p>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted">Estado: <strong>En hoja de ruta</strong></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" disabled aria-disabled="true">Configurar</button>
                        </div>
                    </div>
                </div>

                <!-- Integración 2: Terminal Bancaria -->
                <div class="col-12 col-md-6">
                    <div class="p-4 rounded-3 border h-100 d-flex flex-column justify-content-between opacity-75" style="background-color: #FAF8F5;">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-credit-card text-primary fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6 fw-bold text-dark mb-0">Terminal / Tarjetas</h3>
                                        <span class="small text-muted">Procesador bancario</span>
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1">Próximamente</span>
                            </div>
                            <p class="small text-muted mb-0">Integración directa con terminales punto de venta en caja.</p>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted">Estado: <strong>En hoja de ruta</strong></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" disabled aria-disabled="true">Configurar</button>
                        </div>
                    </div>
                </div>

                <!-- Integración 3: Correo Transaccional -->
                <div class="col-12 col-md-6">
                    <div class="p-4 rounded-3 border h-100 d-flex flex-column justify-content-between opacity-75" style="background-color: #FAF8F5;">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-server text-warning-emphasis fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6 fw-bold text-dark mb-0">SMTP Transaccional</h3>
                                        <span class="small text-muted">Servidor de mensajería</span>
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1">Próximamente</span>
                            </div>
                            <p class="small text-muted mb-0">Entrega automatizada de estados de cuenta y notificaciones.</p>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted">Estado: <strong>En hoja de ruta</strong></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" disabled aria-disabled="true">Ver estado</button>
                        </div>
                    </div>
                </div>

                <!-- Integración 4: Webhook de Cobranza -->
                <div class="col-12 col-md-6">
                    <div class="p-4 rounded-3 border h-100 d-flex flex-column justify-content-between opacity-75" style="background-color: #FAF8F5;">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-code text-secondary fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6 fw-bold text-dark mb-0">Webhooks y APIs</h3>
                                        <span class="small text-muted">Sincronización externa</span>
                                    </div>
                                </div>
                                <span class="badge bg-light text-muted border rounded-pill px-2 py-1">Próximamente</span>
                            </div>
                            <p class="small text-muted mb-0">Endpoints seguros para conciliación automática de transferencias STP.</p>
                        </div>
                        <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted font-monospace" style="font-size: 0.7rem;">Reconciliación STP</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" disabled aria-disabled="true">Claves API</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<!-- Modal Crear / Editar Usuario (Panel Administración) -->
<div class="modal fade" id="modalUsuarioConfig" tabindex="-1" aria-labelledby="modalUsuarioConfigLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h2 class="modal-title h5 fw-bold text-dark" id="modalUsuarioConfigLabel">Nuevo usuario</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body py-3">
                <div id="alertaModalUsuarioConfig" class="alert alert-danger d-none rounded-3 small py-2 px-3 mb-3" role="alert"></div>
                <input type="hidden" id="usuarioConfigId" value="" />
                <div class="mb-3">
                    <label for="usuarioConfigNombre" class="form-label small fw-semibold text-dark">Nombre completo <span class="text-danger">*</span></label>
                    <input type="text" id="usuarioConfigNombre" class="form-control rounded-3" placeholder="Ej. Sofía Ramírez" required />
                </div>
                <div class="mb-3">
                    <label for="usuarioConfigCorreo" class="form-label small fw-semibold text-dark">Correo electrónico <span class="text-danger">*</span></label>
                    <input type="email" id="usuarioConfigCorreo" class="form-control rounded-3" placeholder="colaborador@funeraria.com" required />
                </div>
                <div class="mb-3">
                    <label for="usuarioConfigRol" class="form-label small fw-semibold text-dark">Rol operativo <span class="text-danger">*</span></label>
                    <select id="usuarioConfigRol" class="form-select rounded-3">
                        <option value="Administrador">Administrador</option>
                        <option value="Vendedor" selected>Vendedor</option>
                        <option value="Cajero">Cajero</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label for="usuarioConfigPassword" id="labelPasswordUsuarioConfig" class="form-label small fw-semibold text-dark">Contraseña</label>
                    <input type="password" id="usuarioConfigPassword" class="form-control rounded-3" placeholder="Mínimo 6 caracteres" />
                    <small id="ayudaPasswordUsuarioConfig" class="text-muted d-block mt-1">Obligatoria al dar de alta (mínimo 6 caracteres).</small>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarUsuarioConfig" class="btn text-white rounded-3 px-4 fw-medium" style="background-color: var(--sf-primary-olive, #2D4224);">
                    <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Guardar usuario
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos para el switch verde olivo Serenia */
    .sf-switch-olive:checked {
        background-color: #2D4224 !important;
        border-color: #2D4224 !important;
    }
    .sf-switch-olive:focus {
        border-color: #2D4224;
        box-shadow: 0 0 0 0.25rem rgba(45, 66, 36, 0.25);
    }

    /* Submenú de configuración */
    .sf-config-nav-item {
        color: #4B5563;
        background-color: transparent;
        padding: 12px 16px;
        border-radius: 10px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .sf-config-nav-item:hover:not(.active) {
        background-color: #F8F6F2;
        color: #17211F;
    }
    .sf-config-nav-item.active {
        background-color: #FAF8F5 !important;
        color: #2D4224 !important;
        font-weight: 600 !important;
    }
    .sf-config-nav-item.active .sf-nav-icon {
        color: #2D4224 !important;
    }
</style>

