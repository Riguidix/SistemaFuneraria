@page "/Contratos/Detalle"
@model SistemaFuneraria.Web.Pages.Contratos.DetalleModel
@{
    ViewData["Title"] = $"Expediente {Model.Folio} - Contratos";
    var culture = new System.Globalization.CultureInfo("es-MX");
}

<style>
    .text-tabular {
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
    }
    @@media print {
        .funeraria-sidebar, .funeraria-topbar, .funeraria-fab-help, .btn-no-print, .modal, #sf-toast-container {
            display: none !important;
        }
        body, .funeraria-main-content {
            background-color: #FFFFFF !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .card {
            box-shadow: none !important;
            border: 1px solid #E5E7EB !important;
        }
    }
</style>

<!-- Estado 404 / Contrato no encontrado (SF-064) -->
<div id="contratoNoEncontrado" class="card border-0 shadow-sm rounded-4 p-5 text-center mb-4 d-none" role="alert">
    <div class="py-3">
        <i class="fa-solid fa-file-circle-xmark fa-2x text-muted mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark mb-2">Contrato no encontrado (404)</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 460px;">
            No localizamos el expediente solicitado. Verifica el folio o regresa al listado general de contratos.
        </p>
        <a href="/Contratos" class="btn btn-funeraria-primary rounded-3 px-4">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver a Contratos
        </a>
    </div>
</div>

<div id="contratoContenidoPrincipal">
    <!-- Cabecera del Expediente de Contrato -->
    <div class="funeraria-page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <span class="funeraria-kicker text-uppercase fw-bold text-muted small tracking-wide">CARTERA / EXPEDIENTE DE CONTRATO</span>
            <h2 class="h2 fw-bold text-dark mb-1" id="detalleFolioContrato">@Model.Folio</h2>
            <div class="d-flex align-items-center flex-wrap gap-2 text-muted small">
                <span><strong>Titular:</strong> <span id="detalleTitularContrato">@Model.Titular</span></span>
                <span>&middot;</span>
                <span><strong>Lote:</strong> <span id="detalleLoteContrato">@Model.Lote</span></span>
                <span class="badge rounded-pill @Model.EstadoBadgeClass px-3 py-1 fw-medium" id="badgeEstadoContrato">@Model.Estado</span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 btn-no-print">
            <a href="/Contratos" class="btn btn-outline-secondary rounded-3 px-3 py-2">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver a contratos
            </a>
            <a href="/Caja?contrato=@Model.Folio" id="btnIrACajaContrato" class="btn text-white rounded-3 px-3 py-2 fw-medium shadow-sm" style="background-color: #2D4224;">
                <i class="fa-solid fa-cash-register me-1" aria-hidden="true"></i> Registrar pago en Caja
            </a>
            <button type="button" id="btnImprimirContrato" class="btn btn-light border rounded-3 px-3 py-2" onclick="window.print();" title="Imprimir contrato">
                <i class="fa-solid fa-print me-1" aria-hidden="true"></i> Imprimir contrato
            </button>
            <button type="button" id="btnAbrirModalAdminEstado" class="btn btn-outline-dark rounded-3 px-3 py-2" data-roles="Administrador" data-bs-toggle="modal" data-bs-target="#modalAdminEstadoContrato" title="Panel exclusivo de administración">
                <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i> Gestionar estado (Admin)
            </button>
        </div>
    </div>

    <!-- Tarjetas KPI del Plan Financiero -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white rounded-4 shadow-sm border p-3 h-100">
                <small class="text-muted fw-semibold d-block text-uppercase">PRECIO PACTADO</small>
                <div class="h5 fw-bold text-dark mb-0 text-tabular" id="detallePrecioPactado">@Model.PrecioPactado.ToString("C2", culture)</div>
                <small class="text-muted" id="detalleSubtituloPrecio">Enganche: @Model.Enganche.ToString("C2", culture) (@Model.EnganchePorcentaje.ToString("0")%)</small>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white rounded-4 shadow-sm border p-3 h-100">
                <small class="text-muted fw-semibold d-block text-uppercase">SALDO INSOLUTO</small>
                <div class="h5 fw-bold text-success mb-0 text-tabular" id="detalleSaldoInsoluto">@Model.SaldoInsoluto.ToString("C2", culture)</div>
                <small class="text-muted">Capital pendiente</small>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white rounded-4 shadow-sm border p-3 h-100">
                <small class="text-muted fw-semibold d-block text-uppercase">MENSUALIDAD</small>
                <div class="h5 fw-bold text-dark mb-0 text-tabular" id="detalleMensualidad">@Model.MensualidadRegular.ToString("C2", culture)</div>
                <small class="text-muted" id="detalleSubtituloMensualidad">Próximo vencimiento: @Model.ProximoVencimiento</small>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="bg-white rounded-4 shadow-sm border p-3 h-100">
                <small class="text-muted fw-semibold d-block text-uppercase">PLAZO Y TASA</small>
                <div class="h5 fw-bold text-dark mb-0" id="detallePlazoTasa">@Model.PlazoMeses meses</div>
                <small class="text-muted" id="detalleSubtituloTasa">Tasa anual fija: @Model.TasaAnual.ToString("0")%</small>
            </div>
        </div>
    </div>

    <!-- Comprobante Imprimible de Venta de Contado (SF-064) -->
    <div id="comprobanteContadoCard" class="bg-white rounded-4 shadow-sm border p-4 mb-4 d-none">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 border-bottom pb-3 mb-3">
            <div>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mb-2">Comprobante Oficial · Contado</span>
                <h3 class="h5 fw-bold text-dark mb-0">Liquidación Total en Una Sola Exhibición</h3>
            </div>
            <button type="button" class="btn btn-funeraria-primary rounded-3 px-4 btn-no-print" onclick="window.print();">
                <i class="fa-solid fa-print me-1" aria-hidden="true"></i> Imprimir comprobante
            </button>
        </div>
        <div class="row g-3 small">
            <div class="col-6 col-md-3">
                <div class="text-muted">Folio de Contrato</div>
                <div class="fw-bold text-dark sf-monospace" id="comprobanteFolioContrato">-</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted">Folio de Pago</div>
                <div class="fw-bold text-dark sf-monospace" id="comprobanteFolioPago">-</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted">Fecha de Operación</div>
                <div class="fw-bold text-dark" id="comprobanteFechaVenta">-</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted">Importe Liquidado</div>
                <div class="fw-bold text-success text-tabular" id="comprobantePrecioPagado">$0.00</div>
            </div>
        </div>
    </div>

    <!-- Tabla Completa de Amortización -->
    <div id="seccionTablaAmortizacion" class="bg-white rounded-4 shadow-sm border p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-1">Calendario de pagos y amortización</h5>
                <p class="small text-muted mb-0">Detalle de cuotas ordinarias, desglose de capital, interés y saldo remanente con ajuste francés.</p>
            </div>
            <span id="badgeConteoAmortizacion" class="badge bg-light text-dark border px-3 py-2 rounded-pill small">
                <i class="fa-solid fa-file-invoice-dollar me-1 text-success" aria-hidden="true"></i> @Model.Amortizacion.Count Cuotas calculadas
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-tabular" id="tablaAmortizacionContrato">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th scope="col" class="ps-3" style="width: 50px;">#</th>
                        <th scope="col">Vencimiento</th>
                        <th scope="col" class="text-end">Saldo Inicial</th>
                        <th scope="col" class="text-end">Capital</th>
                        <th scope="col" class="text-end">Interés</th>
                        <th scope="col" class="text-end fw-bold">Cuota Total</th>
                        <th scope="col" class="text-end">Saldo Final</th>
                        <th scope="col" class="text-center pe-3">Estado</th>
                    </tr>
                </thead>
                <tbody id="tbodyAmortizacion">
                    @foreach (var c in Model.Amortizacion)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-muted">@c.Numero</td>
                            <td class="text-dark">@c.Vencimiento</td>
                            <td class="text-end text-muted">@c.SaldoInicial.ToString("C2", culture)</td>
                            <td class="text-end text-dark">@c.Capital.ToString("C2", culture)</td>
                            <td class="text-end text-muted">@c.Interes.ToString("C2", culture)</td>
                            <td class="text-end fw-bold text-dark">@c.CuotaTotal.ToString("C2", culture)</td>
                            <td class="text-end fw-medium @(c.SaldoFinal == 0 ? "text-success" : "text-dark")">@c.SaldoFinal.ToString("C2", culture)</td>
                            <td class="text-center pe-3">
                                <span class="@c.EstadoBadgeClass rounded-pill px-2 py-1 small">@c.Estado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal de Gestión Exclusiva de Administrador (SF-063 / SF-071) -->
<div class="modal fade" id="modalAdminEstadoContrato" tabindex="-1" aria-labelledby="modalAdminEstadoContratoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="modalAdminEstadoContratoLabel">
                    <i class="fa-solid fa-shield-halved me-2 text-dark" aria-hidden="true"></i>Gestión Administrativa del Contrato
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body py-3">
                <div id="alertaModalAdminContrato" class="alert alert-danger d-none rounded-3 small py-2 px-3 mb-3" role="alert"></div>
                <p class="small text-muted mb-3">Actualiza el estado operativo del contrato <strong id="modalAdminFolioContrato">@Model.Folio</strong> en el sistema.</p>
                <div class="mb-3">
                    <label for="selectNuevoEstadoAdmin" class="form-label small fw-semibold text-dark">Nuevo Estado</label>
                    <select class="form-select rounded-3" id="selectNuevoEstadoAdmin">
                        <option value="Activo">Activo</option>
                        <option value="EnRevision">En revisión administrativa</option>
                        <option value="Cancelado">Cancelado (libera lote)</option>
                    </select>
                </div>
                <div class="mb-3" id="campoMotivoCancelacion">
                    <label for="motivoCancelacionAdmin" class="form-label small fw-semibold text-dark">Motivo Administrativo (Mín. 10 caracteres) <span class="text-danger">*</span></label>
                    <textarea class="form-control rounded-3" id="motivoCancelacionAdmin" rows="3" placeholder="Explique el motivo del cambio o cancelación (mínimo 10 caracteres)..." required></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn text-white rounded-3 px-4 fw-medium" id="btnGuardarEstadoAdmin" style="background-color: #2D4224;">
                    <i class="fa-solid fa-check me-1" aria-hidden="true"></i> Guardar cambio de estado
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/api/ventasApi.js" asp-append-version="true"></script>
    <script src="~/js/api/contratosApi.js" asp-append-version="true"></script>
    <script src="~/js/pages/contratoDetallePage.js" asp-append-version="true"></script>
}
