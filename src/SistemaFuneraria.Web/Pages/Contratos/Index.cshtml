@page
@model SistemaFuneraria.Web.Pages.Contratos.IndexModel
@{
    ViewData["Title"] = "Cartera de Contratos - Funeraria";
}

<!-- ========================================================
     1. ENCABEZADO DE PÁGINA (Figma Captura 9)
     ======================================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.08em; font-size: 0.75rem;">CARTERA</span>
        <h1 class="fw-bold mt-1 mb-1" style="color: var(--sf-text-dark, #1F2937); font-size: 2.25rem; letter-spacing: -0.02em;">Contratos</h1>
        <p class="text-muted mb-0" style="font-size: 1rem;">Seguimiento de contratos activos, liquidados y vencidos.</p>
    </div>

    <!-- Acción Superior Derecha: Redirección al Wizard de Nueva Venta -->
    <div>
        <a href="/Ventas/Nueva" 
           class="btn text-white fw-semibold rounded-3 px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2"
           style="background-color: var(--sf-primary-olive, #2D4224); border-color: var(--sf-primary-olive, #2D4224);"
           title="Crear nueva venta">
            <i class="fa-solid fa-plus"></i>
            <span>+ Nueva venta</span>
        </a>
    </div>
</div>

<!-- ========================================================
     2. CUADRÍCULA DE 4 TARJETAS KPI SUPERIORES
     ======================================================== -->
<div class="row g-3 mb-4">
    <!-- 1. Activos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 p-xl-4 bg-white h-100">
            <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Activos</span>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="display-6 fw-bold text-dark sf-money">@Model.TotalActivos</span>
            </div>
            <div class="text-muted small mt-1">Total vigentes en cartera</div>
        </div>
    </div>

    <!-- 2. Al corriente -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 p-xl-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Al corriente</span>
                <span class="badge bg-success-subtle text-success small fw-semibold px-2 py-1 rounded-pill">93.7%</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="display-6 fw-bold text-dark sf-money">@Model.TotalAlCorriente</span>
            </div>
            <div class="text-muted small mt-1">Sin atraso de cuotas</div>
        </div>
    </div>

    <!-- 3. Con atraso -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 p-xl-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Con atraso</span>
                <span class="badge bg-danger-subtle text-danger small fw-semibold px-2 py-1 rounded-pill">Requieren atención</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="display-6 fw-bold text-danger sf-money">@Model.TotalConAtraso</span>
            </div>
            <div class="text-muted small mt-1">Mensualidades vencidas</div>
        </div>
    </div>

    <!-- 4. Liquidados este año -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 p-xl-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Liquidados este año</span>
                <span class="badge bg-warning-subtle text-warning-emphasis small fw-semibold px-2 py-1 rounded-pill">Meta 2025</span>
            </div>
            <div class="d-flex align-items-baseline gap-2 mt-2">
                <span class="display-6 fw-bold text-dark sf-money">@Model.TotalLiquidados</span>
            </div>
            <div class="text-muted small mt-1">Cierre total de amortización</div>
        </div>
    </div>
</div>

<!-- ========================================================
     3. BARRA DE HERRAMIENTAS (TOOLBAR CON BÚSQUEDA Y TABS)
     ======================================================== -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <!-- Lado Izquierdo: Buscador Reactivo -->
    <div class="position-relative" style="max-width: 360px; width: 100%;">
        <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
        <input type="text" 
               id="inputBuscarContratos" 
               class="form-control ps-5 rounded-3 py-2 border shadow-sm" 
               placeholder="Buscar contrato o cliente..."
               aria-label="Buscar contrato o cliente" />
    </div>

    <!-- Lado Derecho: Segmented Control de 4 Pestañas -->
    <div class="bg-white p-1 rounded-3 border shadow-sm d-inline-flex gap-1" role="tablist">
        <button type="button" 
                class="btn btn-sm px-3 py-1-5 rounded-2 fw-medium btn-tab-filtro active" 
                data-filtro-estado="todos"
                onclick="cambiarTab(this, 'todos')">
            Todos
        </button>
        <button type="button" 
                class="btn btn-sm px-3 py-1-5 rounded-2 fw-medium btn-tab-filtro text-muted" 
                data-filtro-estado="activos"
                onclick="cambiarTab(this, 'activos')">
            Activos
        </button>
        <button type="button" 
                class="btn btn-sm px-3 py-1-5 rounded-2 fw-medium btn-tab-filtro text-muted" 
                data-filtro-estado="vencidos"
                onclick="cambiarTab(this, 'vencidos')">
            Vencidos
        </button>
        <button type="button" 
                class="btn btn-sm px-3 py-1-5 rounded-2 fw-medium btn-tab-filtro text-muted" 
                data-filtro-estado="liquidados"
                onclick="cambiarTab(this, 'liquidados')">
            Liquidados
        </button>
    </div>
</div>

