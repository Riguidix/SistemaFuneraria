@page "/Catalogo"
@model SistemaFuneraria.Web.Pages.Catalogo.IndexModel
@{
    ViewData["Title"] = "Catálogo de Lotes - Inventario";
}

<!-- Encabezado de Página -->
<div class="funeraria-page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="funeraria-kicker text-uppercase fw-bold">INVENTARIO</span>
        <h1 class="funeraria-page-title mb-1">Catálogo de lotes</h1>
        <p class="funeraria-page-subtitle text-muted mb-0">Consulta disponibilidad, ubicación y condiciones comerciales.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button"
                id="btnNuevoLoteAdmin"
                class="btn btn-outline-dark rounded-3 fw-semibold px-3 py-2 d-none"
                data-roles="Administrador">
            <i class="fa-solid fa-layer-group me-1" aria-hidden="true"></i>
            <span>Nuevo lote</span>
        </button>
        <a href="/Ventas/Nueva"
           id="btnCotizarLoteHeader"
           class="btn btn-funeraria-primary text-white rounded-3 fw-semibold px-3 py-2 d-inline-flex align-items-center gap-2 text-decoration-none"
           style="background-color: var(--sf-primary-olive, #2D4224); border-color: var(--sf-primary-olive, #2D4224);">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Cotizar lote</span>
        </a>
    </div>
</div>

<!-- Banner de Error con Reintento -->
<div id="catalogoErrorBanner" class="alert alert-danger d-none align-items-center justify-content-between gap-3 rounded-4 border-0 shadow-sm mb-4" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <span id="catalogoErrorText">No se pudo cargar el catálogo de lotes.</span>
    </div>
    <button type="button" id="btnReintentarCatalogo" class="btn btn-sm btn-outline-danger rounded-3 fw-semibold">
        Reintentar
    </button>
</div>

<!-- Barra de Herramientas: Buscador y Selectores de Sección y Estado -->
<div class="funeraria-toolbar mb-4">
    <div class="funeraria-search-box flex-grow-1">
        <i class="fa-solid fa-magnifying-glass funeraria-search-icon" aria-hidden="true"></i>
        <input type="text"
               id="inputBuscarLotes"
               class="form-control funeraria-search-input"
               placeholder="Buscar por clave, sección o capacidad"
               autocomplete="off"
               aria-label="Buscar lotes" />
        <button type="button" id="btnClearSearchLotes" class="btn-clear-search" aria-label="Limpiar búsqueda" title="Limpiar búsqueda">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <select id="selectSeccion" class="form-select funeraria-select" aria-label="Filtrar por sección">
            <option value="todas">Todas las secciones</option>
            <option value="Jardín Norte">Jardín Norte</option>
            <option value="Jardín Central">Jardín Central</option>
            <option value="Robles">Robles</option>
            <option value="Las Magnolias">Las Magnolias</option>
        </select>
        <select id="selectEstado" class="form-select funeraria-select" aria-label="Filtrar por estado">
            <option value="todos">Todos los estados</option>
            <option value="Disponible">Disponible</option>
            <option value="Reservado">Reservado</option>
            <option value="Vendido">Vendido</option>
            <option value="Mantenimiento">Mantenimiento</option>
        </select>
        <div class="sf-view-toggle" role="group" aria-label="Cambiar vista del catálogo">
            <button type="button" id="btnVistaTablaCatalogo" class="sf-view-toggle-btn active" aria-pressed="true">
                <i class="fa-solid fa-table-list me-1" aria-hidden="true"></i> Tabla
            </button>
            <button type="button" id="btnVistaMapaCatalogo" class="sf-view-toggle-btn" aria-pressed="false">
                <i class="fa-solid fa-map me-1" aria-hidden="true"></i> Mapa
            </button>
        </div>
    </div>
</div>

<!-- Fila de Tarjetas KPIs / Métricas de Inventario -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Disponibles -->
    <div class="col-md-4">
        <div class="card funeraria-kpi-card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="kpi-label text-muted small fw-medium mb-1">Disponibles</div>
            <div class="kpi-value fw-bold text-dark fs-1 lh-1 mb-2 sf-money placeholder-glow" id="kpiDisponiblesValor">
                <span class="placeholder col-4 rounded"></span>
            </div>
            <div class="kpi-subtext text-muted small" id="kpiTotalLotesTexto">Cargando inventario...</div>
        </div>
    </div>
    <!-- KPI 2: Precio desde -->
    <div class="col-md-4">
        <div class="card funeraria-kpi-card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="kpi-label text-muted small fw-medium mb-1">Precio desde</div>
            <div class="kpi-value fw-bold text-dark fs-2 lh-1 mb-2 formato-moneda sf-money placeholder-glow" id="kpiPrecioDesde">
                <span class="placeholder col-6 rounded"></span>
            </div>
            <div class="kpi-subtext text-muted small">pago de contado</div>
        </div>
    </div>
    <!-- KPI 3: Sección con más espacio -->
    <div class="col-md-4">
        <div class="card funeraria-kpi-card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="kpi-label text-muted small fw-medium mb-1">Sección con más espacio</div>
            <div class="kpi-value fw-bold text-dark fs-3 lh-1 mb-2 placeholder-glow" id="kpiSeccionMasEspacio">
                <span class="placeholder col-7 rounded"></span>
            </div>
            <div class="kpi-subtext text-muted small" id="kpiSeccionLibresTexto">--</div>
        </div>
    </div>
</div>

<!-- Card Contenedor: Tabla de Lotes -->
<div id="catalogoVistaTabla" class="funeraria-table-card card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table funeraria-table align-middle mb-0" id="tablaLotes" aria-label="Catálogo de lotes funerarios">
            <thead>
                <tr>
                    <th scope="col" class="ps-4 th-sortable" data-sort-col="clave" tabindex="0" role="button" aria-sort="none" title="Ordenar por Clave">
                        CLAVE <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                    </th>
                    <th scope="col" class="th-sortable" data-sort-col="ubicacion" tabindex="0" role="button" aria-sort="none" title="Ordenar por Ubicación">
                        UBICACIÓN <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                    </th>
                    <th scope="col" class="th-sortable" data-sort-col="capacidad" tabindex="0" role="button" aria-sort="none" title="Ordenar por Capacidad">
                        CAPACIDAD <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                    </th>
                    <th scope="col" class="th-sortable" data-sort-col="precio" tabindex="0" role="button" aria-sort="none" title="Ordenar por Precio de Lista">
                        PRECIO DE LISTA <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                    </th>
                    <th scope="col">ESTADO</th>
                    <th scope="col" class="text-end pe-4"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody id="tbodyLotes">
                <tr id="filaCargandoLotes">
                    <td colspan="6" class="text-center py-5 text-muted small placeholder-glow">
                        <span class="placeholder col-6 rounded"></span>
                    </td>
                </tr>
                <tr id="filaSinResultadosLotes" class="d-none">
                    <td colspan="6" class="text-center py-5">
                        <div class="py-4 text-muted">
                            <i class="fa-solid fa-magnifying-glass fa-2x mb-2 opacity-50 d-block" aria-hidden="true"></i>
                            <div class="fw-semibold fs-6 text-dark mb-1">No se encontraron lotes</div>
                            <div class="small mb-3">Ningún lote coincide con los filtros aplicados.</div>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="btnResetLotes">
                                <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Restablecer filtros
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Paginación Dinámica -->
    <div class="funeraria-table-footer">
        <div class="table-pagination-info">
            Mostrando <strong id="lotesDesde">0</strong> a <strong id="lotesHasta">0</strong> de <strong id="lotesTotal">0</strong> lotes
        </div>
        <nav aria-label="Paginación de catálogo de lotes">
            <ul class="funeraria-pagination" id="paginacionLotes">
                <li>
                    <button type="button" class="page-btn disabled" disabled aria-label="Página anterior">Anterior</button>
                </li>
                <li>
                    <button type="button" class="page-btn active" aria-current="page">1</button>
                </li>
                <li>
                    <button type="button" class="page-btn disabled" disabled aria-label="Página siguiente">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Card Contenedor: Vista Mapa / Plano de Lotes -->
<div id="catalogoVistaMapa" class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white d-none">
    <div id="contenedorMapaCatalogo"></div>
</div>

<!-- Modal Detalle de Lote y Trazabilidad de Estado (SF-046) -->
<partial name="_DetalleLoteModal" />

<!-- Modal CRUD Administrativo Alta/Edición de Lote -->
<partial name="_FormularioLoteModal" />

@section Scripts {
    <script src="~/js/api/lotesApi.js" asp-append-version="true"></script>
    <script src="~/js/components/mapaLotes.js" asp-append-version="true"></script>
    <script src="~/js/pages/catalogoPage.js" asp-append-version="true"></script>
}
