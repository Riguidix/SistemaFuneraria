@page
@model SistemaFuneraria.Web.Pages.ParametrosUiModel
@{
    ViewData["Title"] = "Parámetros UI - Design System";
}

<!-- Encabezado de Página (Figma Captura 13) -->
<div class="mb-4">
    <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.08em; font-size: 0.75rem;">DESIGN SYSTEM</span>
    <h1 class="fw-bold mt-1 mb-1" style="color: var(--ink, #17211f); font-size: 2.25rem; letter-spacing: -0.02em;">Parámetros UI</h1>
    <p class="text-muted mb-0" style="font-size: 1rem;">Inventario visual de las ventanas, su estructura y los colores oficiales del sistema.</p>
</div>

<!-- ========================================================
     SECCIÓN 1: Variables CSS del Proyecto (Figma Captura 13)
     ======================================================== -->
<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
    <div class="mb-4">
        <h2 class="h5 fw-bold mb-1" style="color: var(--ink, #17211f);">Variables CSS del Proyecto</h2>
        <p class="text-muted small mb-0">Paleta oficial de identidad institucional utilizada en la aplicación.</p>
    </div>

    <!-- Grid de Swatches Fiel a Figma Captura 13 -->
    <div class="row g-3 mb-3">
        <!-- 1. Forest -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--forest, #173f3a);" title="#173f3a"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Forest</div>
                    <div class="text-muted token-code">--forest</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--forest, #173f3a);">#173f3a</div>
                </div>
            </div>
        </div>

        <!-- 2. Forest 2 -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--forest-2, #245c53);" title="#245c53"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Forest 2</div>
                    <div class="text-muted token-code">--forest-2</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--forest-2, #245c53);">#245c53</div>
                </div>
            </div>
        </div>

        <!-- 3. Gold -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--gold, #c59d52);" title="#c59d52"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Gold</div>
                    <div class="text-muted token-code">--gold</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--gold, #c59d52);">#c59d52</div>
                </div>
            </div>
        </div>

        <!-- 4. Rose -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--rose, #a84f4b);" title="#a84f4b"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Rose</div>
                    <div class="text-muted token-code">--rose</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--rose, #a84f4b);">#a84f4b</div>
                </div>
            </div>
        </div>

        <!-- 5. Canvas -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box border" style="background-color: var(--canvas, #f4f6f3); border-color: #D1D5DB !important;" title="#f4f6f3"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Canvas</div>
                    <div class="text-muted token-code">--canvas</div>
                    <div class="token-code fw-semibold text-truncate text-muted">#f4f6f3</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2 de Captura 13 (Ink) -->
    <div class="row g-3">
        <!-- 6. Ink -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--ink, #17211f);" title="#17211f"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Ink</div>
                    <div class="text-muted token-code">--ink</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--ink, #17211f);">#17211f</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     SECCIÓN 2: Colores del Tema Activo Web (Serenia Funeraria)
     ======================================================== -->
<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
    <div class="mb-4">
        <h2 class="h5 fw-bold mb-1" style="color: var(--ink, #17211f);">Colores del Tema Activo Web (Serenia Funeraria)</h2>
        <p class="text-muted small mb-0">Tokens en vivo aplicados en layout, navegación lateral, tablas y componentes interactivos.</p>
    </div>

    <div class="row g-3">
        <!-- Verde Olivo Primario -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--sf-primary-olive, #2D4224);" title="#2D4224"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Verde Olivo Primario</div>
                    <div class="text-muted token-code">--sf-primary-olive</div>
                    <div class="token-code fw-semibold text-truncate" style="color: #2D4224;">#2D4224</div>
                </div>
            </div>
        </div>

        <!-- Verde Sidebar -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--sf-sidebar-green, #485635);" title="#485635"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Verde Sidebar</div>
                    <div class="text-muted token-code">--sf-sidebar-green</div>
                    <div class="token-code fw-semibold text-truncate" style="color: #485635;">#485635</div>
                </div>
            </div>
        </div>

        <!-- Fondo Crema Memorial -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box border" style="background-color: var(--sf-bg-cream, #F4F1EA); border-color: #E6DFD3 !important;" title="#F4F1EA"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Fondo Crema Memorial</div>
                    <div class="text-muted token-code">--sf-bg-cream</div>
                    <div class="token-code fw-semibold text-truncate text-muted">#F4F1EA</div>
                </div>
            </div>
        </div>

        <!-- Card Superficie -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box border" style="background-color: var(--sf-card-white, #FCFAF7); border-color: #E6DFD3 !important;" title="#FCFAF7"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Card Superficie</div>
                    <div class="text-muted token-code">--sf-card-white</div>
                    <div class="token-code fw-semibold text-truncate text-muted">#FCFAF7</div>
                </div>
            </div>
        </div>

        <!-- Borde Neutro -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box border" style="background-color: var(--sf-border-neutral, #E6DFD3); border-color: #D1D5DB !important;" title="#E6DFD3"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Borde Neutro</div>
                    <div class="text-muted token-code">--sf-border-neutral</div>
                    <div class="token-code fw-semibold text-truncate text-muted">#E6DFD3</div>
                </div>
            </div>
        </div>

        <!-- Texto Principal -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--sf-text-dark, #1F2937);" title="#1F2937"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Texto Principal</div>
                    <div class="text-muted token-code">--sf-text-dark</div>
                    <div class="token-code fw-semibold text-truncate" style="color: #1F2937;">#1F2937</div>
                </div>
            </div>
        </div>

        <!-- Texto Secundario -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--sf-text-muted, #6B7280);" title="#6B7280"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Texto Secundario</div>
                    <div class="text-muted token-code">--sf-text-muted</div>
                    <div class="token-code fw-semibold text-truncate text-muted">#6B7280</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     SECCIÓN 3: Tipografía, Jerarquía y Cifras Monetarias
     ======================================================== -->
<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
    <div class="mb-4">
        <h2 class="h5 fw-bold mb-1" style="color: var(--ink, #17211f);">Tipografía, Jerarquía y Utilidades de Cifras</h2>
        <p class="text-muted small mb-0">Pesos tipográficos oficiales Inter, escala de encabezados y formateo tabular monetario es-MX.</p>
    </div>

    <!-- Bloque 1: Pesos de Fuente -->
    <div class="mb-5">
        <h3 class="h6 fw-bold text-uppercase text-muted mb-3" style="letter-spacing: 0.05em; font-size: 0.8rem;">Pesos de Fuente (Inter)</h3>
        <div class="p-4 rounded-3 border bg-light bg-opacity-50">
            <div class="row g-3 align-items-center mb-3 pb-3 border-bottom">
                <div class="col-12 col-md-3">
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Regular (400)</span>
                </div>
                <div class="col-12 col-md-9">
                    <p class="mb-0 fw-normal" style="font-size: 1.05rem;">"El servicio y la memoria familiar con dignidad."</p>
                </div>
            </div>

            <div class="row g-3 align-items-center mb-3 pb-3 border-bottom">
                <div class="col-12 col-md-3">
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Medium (500)</span>
                </div>
                <div class="col-12 col-md-9">
                    <p class="mb-0 fw-medium" style="font-size: 1.05rem;">"Gestión de contratos, expedientes y titularidad."</p>
                </div>
            </div>

            <div class="row g-3 align-items-center mb-3 pb-3 border-bottom">
                <div class="col-12 col-md-3">
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Semi-bold (600)</span>
                </div>
                <div class="col-12 col-md-9">
                    <p class="mb-0 fw-semibold" style="font-size: 1.05rem;">"Módulos operativos y parámetros de configuración."</p>
                </div>
            </div>

            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-3">
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Bold (700)</span>
                </div>
                <div class="col-12 col-md-9">
                    <p class="mb-0 fw-bold" style="font-size: 1.05rem;">"Sistema Funerario — Serenia Memorial."</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bloque 2: Escala de Encabezados -->
    <div class="mb-5">
        <h3 class="h6 fw-bold text-uppercase text-muted mb-3" style="letter-spacing: 0.05em; font-size: 0.8rem;">Escala de Encabezados y Texto</h3>
        <div class="p-4 rounded-3 border bg-light bg-opacity-50">
            <div class="d-flex flex-column gap-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline border-bottom pb-2">
                    <h1 class="mb-0 fw-bold">Encabezado H1 (2.25rem · 36px)</h1>
                    <span class="text-muted small">Títulos de vista principal</span>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline border-bottom pb-2">
                    <h2 class="mb-0 fw-bold">Encabezado H2 (1.75rem · 28px)</h2>
                    <span class="text-muted small">Secciones principales</span>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline border-bottom pb-2">
                    <h3 class="mb-0 fw-semibold">Encabezado H3 (1.375rem · 22px)</h3>
                    <span class="text-muted small">Subsecciones y tarjetas</span>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline border-bottom pb-2">
                    <h4 class="mb-0 fw-semibold">Encabezado H4 (1.125rem · 18px)</h4>
                    <span class="text-muted small">Títulos de modales y widgets</span>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline border-bottom pb-2">
                    <p class="mb-0">Cuerpo de Texto Body (1rem · 16px) — Tipografía legible y confortable para lectura continua.</p>
                    <span class="text-muted small">Párrafos y tablas</span>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline">
                    <small class="text-muted">Texto Small / Kicker (0.875rem · 14px) — Metadatos, etiquetas y avisos sutiles.</small>
                    <span class="text-muted small">Metadatos</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bloque 3: Utilidad Monetaria .sf-money -->
    <div>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="h6 fw-bold text-uppercase text-muted mb-0" style="letter-spacing: 0.05em; font-size: 0.8rem;">Utilidad Monetaria .sf-money (Números Tabulares es-MX)</h3>
            <span class="badge bg-success-subtle text-success border border-success-subtle">font-variant-numeric: tabular-nums</span>
        </div>
        <p class="text-muted small mb-3">Permite que las columnas de importes alineen perfectamente sus dígitos y puntos decimales sin saltos visuales.</p>

        <div class="table-responsive rounded-3 border bg-white">
            <table class="table align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">CONCEPTO FINANCIERO</th>
                        <th>DESCRIPCIÓN</th>
                        <th class="text-end pe-4">IMPORTE FORMATEADO (.sf-money)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-semibold text-dark">Precio de Lista / Saldo Total</td>
                        <td class="text-muted small">Lote memorial 3 gavetas Jardín Norte</td>
                        <td class="text-end pe-4">
                            <span class="sf-money fw-bold text-success fs-5">$127,500.00 MXN</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-semibold text-dark">Cuota Mensual Ordinaria</td>
                        <td class="text-muted small">Mensualidad francesa 1 de 24 plazo fijo</td>
                        <td class="text-end pe-4">
                            <span class="sf-money fw-semibold text-dark fs-5">$8,710.16 MXN</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-semibold text-dark">Cartera Vencida / Saldo en Mora</td>
                        <td class="text-muted small">Acumulado con 0 recargo moratorio (RN-10)</td>
                        <td class="text-end pe-4">
                            <span class="sf-money fw-bold text-danger fs-5">$76,180.40 MXN</span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-semibold text-dark">Abono Extraordinario a Capital</td>
                        <td class="text-muted small">100% amortizado a capital insoluto</td>
                        <td class="text-end pe-4">
                            <span class="sf-money fw-semibold text-primary fs-5">$10,000.00 MXN</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pill Flotante Inspirada en Figma Captura 13 -->
<div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1050;">
    <div class="toast show align-items-center text-white border-0 shadow-lg rounded-pill" role="alert" aria-live="assertive" aria-atomic="true" style="background-color: #1F2937; opacity: 0.95;">
        <div class="d-flex align-items-center px-3 py-2">
            <div class="toast-body p-0 d-flex align-items-center gap-2 small">
                <i class="fa-solid fa-circle-notch fa-spin text-white-50"></i>
                <span>Cargando vista previa en vivo, es posible que las interacciones no se guarden</span>
            </div>
            <button type="button" class="btn-close btn-close-white ms-2 me-1" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    /* Ajuste para columnas de 5 elementos en pantallas grandes */
    @@media (min-width: 992px) {
        .col-lg-2-4 {
            flex: 0 0 auto;
            width: 20%;
        }
    }
</style>
