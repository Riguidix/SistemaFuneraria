@page
@model SistemaFuneraria.Web.Pages.ParametrosUiModel
@{
    ViewData["Title"] = "Parámetros UI - Design System";
}

<!-- Encabezado de Página (Figma Captura 13) -->
<div class="mb-4">
    <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.08em; font-size: 0.75rem;">DESIGN SYSTEM</span>
    <h1 class="fw-bold mt-1 mb-1" style="color: var(--ink, #17211f); font-size: 2.25rem; letter-spacing: -0.02em;">Parámetros UI</h1>
    <p class="text-muted mb-0" style="font-size: 1rem;">Inventario visual de las ventanas, su estructura y los colores oficiales del sistema.</p>
</div>

<!-- Variables CSS del Proyecto (Figma Captura 13) -->
<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
    <div class="mb-4">
        <h2 class="h5 fw-bold mb-1" style="color: var(--ink, #17211f);">Variables CSS del Proyecto</h2>
        <p class="text-muted small mb-0">Paleta oficial de identidad institucional utilizada en la aplicación.</p>
    </div>

    <!-- Grid de Swatches Fiel a Figma Captura 13 -->
    <div class="row g-3 mb-3">
        <!-- 1. Forest -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--forest, #173f3a);" title="#173f3a"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Forest</div>
                    <div class="text-muted token-code">--forest</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--forest, #173f3a);">#173f3a</div>
                </div>
            </div>
        </div>

        <!-- 2. Forest 2 -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--forest-2, #245c53);" title="#245c53"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Forest 2</div>
                    <div class="text-muted token-code">--forest-2</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--forest-2, #245c53);">#245c53</div>
                </div>
            </div>
        </div>

        <!-- 3. Gold -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--gold, #c59d52);" title="#c59d52"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Gold</div>
                    <div class="text-muted token-code">--gold</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--gold, #c59d52);">#c59d52</div>
                </div>
            </div>
        </div>

        <!-- 4. Rose -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--rose, #a84f4b);" title="#a84f4b"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Rose</div>
                    <div class="text-muted token-code">--rose</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--rose, #a84f4b);">#a84f4b</div>
                </div>
            </div>
        </div>

        <!-- 5. Canvas -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box border" style="background-color: var(--canvas, #f4f6f3); border-color: #D1D5DB !important;" title="#f4f6f3"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Canvas</div>
                    <div class="text-muted token-code">--canvas</div>
                    <div class="token-code fw-semibold text-truncate text-muted">#f4f6f3</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2 de Captura 13 (Ink) -->
    <div class="row g-3">
        <!-- 6. Ink -->
        <div class="col-12 col-sm-6 col-md-4 col-lg-2-4">
            <div class="color-swatch-card h-100">
                <div class="color-swatch-box" style="background-color: var(--ink, #17211f);" title="#17211f"></div>
                <div class="overflow-hidden">
                    <div class="fw-bold text-dark text-truncate" style="font-size: 0.95rem;">Ink</div>
                    <div class="text-muted token-code">--ink</div>
                    <div class="token-code fw-semibold text-truncate" style="color: var(--ink, #17211f);">#17211f</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ajuste para columnas de 5 elementos en pantallas grandes */
    @@media (min-width: 992px) {
        .col-lg-2-4 {
            flex: 0 0 auto;
            width: 20%;
        }
    }
</style>
