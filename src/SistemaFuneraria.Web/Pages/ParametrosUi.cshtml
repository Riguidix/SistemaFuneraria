@page
@model SistemaFuneraria.Web.Pages.ParametrosUiModel
@{
    ViewData["Title"] = "Parámetros UI - Design System";
}

<!-- Encabezado de Página -->
<div class="mb-4">
    <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.08em; font-size: 0.75rem;">DESIGN SYSTEM</span>
    <h1 class="fw-bold mt-1 mb-1" style="color: var(--sf-text-dark, #1F2937); font-size: 2.25rem; letter-spacing: -0.02em;">Parámetros UI</h1>
    <p class="text-muted mb-0" style="font-size: 1rem;">Inventario visual de la paleta activa institucional, escala tonal con color base al centro y tipografía.</p>
</div>

<!-- Notificación Flotante: Color Copiado -->
<div id="toastCopiado" class="toast align-items-center text-white border-0 position-fixed bottom-0 end-0 m-4 shadow-lg rounded-pill d-none" role="alert" style="background-color: #1F2937; z-index: 1060; padding: 0.4rem 1.25rem;">
    <div class="d-flex align-items-center gap-2 small">
        <i class="fa-solid fa-check text-success"></i>
        <span>Color copiado: <strong id="hexCopiadoTexto">#FFFFFF</strong></span>
    </div>
</div>

