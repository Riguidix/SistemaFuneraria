@* Componente Reutilizable: Modal de Registro de Pago de Cuota Ordinaria (Ticket 036 / SF-019/VistaCobranza) *@
<div class="modal fade" id="modalRegistrarPago" tabindex="-1" aria-labelledby="modalRegistrarPagoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content funeraria-modal-card p-2 p-md-3 rounded-4 shadow-sm border-0 bg-white">
            <!-- Encabezado del Modal -->
            <div class="modal-header border-0 pb-1 align-items-start">
                <div>
                    <h2 class="modal-title fs-4 fw-bold text-dark mb-1 d-flex align-items-center" id="modalRegistrarPagoLabel">
                        <i class="fa-solid fa-receipt me-2 text-success"></i> Registrar pago de cuota
                    </h2>
                    <p class="text-muted small mb-0">Captura los datos del pago para registrar la mensualidad y emitir el comprobante foliado.</p>
                </div>
                <button type="button" class="btn-close ms-auto mt-1" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <!-- Cuerpo del Modal -->
            <div class="modal-body py-3">
                <form id="formRegistrarPago" onsubmit="event.preventDefault();">
                    <!-- Fila 1: Folio de contrato y Cliente / Titular -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="pagoFolioContrato" class="form-label fw-medium small text-dark">Folio de contrato / venta</label>
                            <input type="text" 
                                   id="pagoFolioContrato" 
                                   name="FolioContrato" 
                                   class="form-control rounded-3 funeraria-input" 
                                   placeholder="Ej. VTA-2026-000001" 
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label for="pagoClienteTitular" class="form-label fw-medium small text-dark">Cliente / Titular</label>
                            <input type="text" 
                                   id="pagoClienteTitular" 
                                   name="ClienteTitular" 
                                   class="form-control rounded-3 funeraria-input" 
                                   placeholder="Ej. Laura Castañeda" 
                                   required />
                        </div>
                    </div>

                    <!-- Fila 2: Cuota a liquidar y Método de pago -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="pagoCuotaLiquidar" class="form-label fw-medium small text-dark">Cuota a liquidar</label>
                            <input type="text" 
                                   id="pagoCuotaLiquidar" 
                                   name="CuotaLiquidar" 
                                   class="form-control rounded-3 funeraria-input" 
                                   placeholder="Ej. Cuota 1 de 24 ($8,710.16)" 
                                   required />
                        </div>
                        <div class="col-md-6">
                            <label for="pagoMetodoPago" class="form-label fw-medium small text-dark">Método de pago</label>
                            <select id="pagoMetodoPago" name="MetodoPago" class="form-select rounded-3 funeraria-input" required>
                                <option value="efectivo" selected>Efectivo en ventanilla</option>
                                <option value="tarjeta">Tarjeta de Débito / Crédito</option>
                                <option value="spei">Transferencia electrónica (SPEI)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Fila 3: Referencia / Comprobante -->
                    <div class="mb-3">
                        <label for="pagoReferencia" class="form-label fw-medium small text-dark">Referencia / Comprobante</label>
                        <input type="text" 
                               id="pagoReferencia" 
                               name="Referencia" 
                               class="form-control rounded-3 funeraria-input" 
                               placeholder="Ej. AUT-894721 o Folio de transferencia" />
                    </div>

                    <!-- Tarjeta Informativa de Desglose Financiero -->
                    <div class="mt-3 p-3" style="background-color: #F8F7F4; border: 1px solid #E5E0D8; border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">Capital amortizado:</span>
                            <span class="small fw-semibold text-dark">$6,710.16</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted">Intereses ordinarios:</span>
                            <span class="small fw-semibold text-dark">$2,000.00</span>
                        </div>
                        <hr class="my-2" style="border-top: 1px dashed #D5CFB9; margin: 0.5rem 0;" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark">Total a cobrar en MXN:</span>
                            <span class="fs-5 fw-bold" style="color: #2D4224;">$8,710.16</span>
                        </div>
                        <div class="small mt-2 pt-2 border-top text-muted d-flex align-items-center gap-2" style="font-size: 0.78rem; border-color: #EAE5DC !important;">
                            <i class="fa-solid fa-circle-info text-secondary"></i>
                            <span>Al confirmar el cobro se generará automáticamente el comprobante foliado.</span>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Pie del Modal -->
            <div class="modal-footer border-0 pt-1 pb-2 px-3 d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-funeraria-primary rounded-3 px-3 d-inline-flex align-items-center gap-1" id="btnConfirmarPagoModal" style="background-color: #2D4224 !important; border-color: #2D4224 !important; color: #FFFFFF !important;">
                    <i class="fa-solid fa-check me-1"></i> Confirmar pago
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        document.addEventListener('DOMContentLoaded', function () {
            var btn = document.getElementById('btnConfirmarPagoModal');
            if (!btn || btn.dataset.bound) return;
            btn.dataset.bound = "true";

            btn.addEventListener('click', function () {
                var modalEl = document.getElementById('modalRegistrarPago');
                var cliente = document.getElementById('pagoClienteTitular')?.value || 'Cliente';
                var cuota = document.getElementById('pagoCuotaLiquidar')?.value || 'Cuota ordinaria';

                if (modalEl && window.bootstrap) {
                    var modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                }

                var alerta = document.getElementById('alertaPagoExitoso');
                if (alerta) {
                    var txt = document.getElementById('textoPagoExitoso');
                    if (txt) txt.textContent = '¡Pago de ' + cliente + ' registrado exitosamente!';
                    alerta.classList.remove('d-none');
                    alerta.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    alert('✓ Pago registrado exitosamente\n\nTitular: ' + cliente + '\nConcepto: ' + cuota + '\nFolio generado: REC-2026-0043');
                }
            });
        });
    })();
</script>
