@page
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@model SistemaFuneraria.Web.Pages.Cuenta.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión - Sistema Funerario";
    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "http://localhost:5180";
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="api-base-url" content="@apiBaseUrl" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" onerror="this.onerror=null;this.href='/lib/bootstrap/dist/css/bootstrap.min.css';" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/sistema-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
</head>
<body class="login-page-body">
    <div class="login-main-wrapper">
        <!-- Columna izquierda: Hero Memorial (42%) -->
        <aside class="login-hero-column" aria-label="Identidad memorial de la sucursal">
            <div>
                <div class="hero-top-badge">
                    <i class="fa-solid fa-leaf text-success" aria-hidden="true"></i>
                    <span>Parque Memorial</span>
                </div>
            </div>

            <div class="hero-quote-container">
                <div class="hero-memorial-flower-icon">
                    <i class="fa-solid fa-dove" aria-hidden="true"></i>
                </div>
                <blockquote class="hero-quote-text">
                    "Hay vidas que dejan huellas imborrables y recuerdos que florecen para siempre en el corazón."
                </blockquote>
                <p class="hero-quote-author">
                    Acompañamiento digno, calidez humana y certeza patrimonial para las familias en cada momento de trascendencia.
                </p>
            </div>

            <div class="hero-footer-location">
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <span>Chihuahua, Chihuahua</span>
            </div>
        </aside>

        <!-- Columna derecha: Formulario Iniciar Sesión (58%) -->
        <main class="login-form-column">
            <div class="login-form-inner-container">
                <a href="/Cuenta/Login" class="login-brand-header">
                    <div class="login-brand-logo-icon">
                        <i class="fa-solid fa-monument" aria-hidden="true"></i>
                    </div>
                    <span class="login-brand-logo-text">Sistema Funerario</span>
                </a>

                <h1 class="sign-in-title">Iniciar sesión</h1>
                <p class="sign-in-kicker">Plataforma Operativa de Sucursal</p>

                <!-- Contenedor dinámico de alertas SF-028 (3.er intento: gold, 5.° intento: rose lockout) -->
                <div id="loginAlertContainer" aria-live="polite">
                    @if (!ModelState.IsValid && ViewData.ModelState["Input.Email"]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 rounded-3 py-2 small" role="alert">
                            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                            <div>@ViewData.ModelState["Input.Email"]?.Errors[0].ErrorMessage</div>
                        </div>
                    }
                </div>

                <form id="loginForm" method="post" novalidate aria-label="Formulario de inicio de sesión">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="sign-in-label">Correo electrónico</label>
                        <input asp-for="Input.Email" id="Input_Email" class="sign-in-input" placeholder="ejemplo@funeraria.mx" autocomplete="email" required />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="sign-in-label">Contraseña</label>
                        <div class="password-input-wrapper">
                            <input asp-for="Input.Password" id="Input_Password" class="sign-in-input" placeholder="••••••••" autocomplete="current-password" required />
                            <button type="button" class="btn-eye-toggle" id="btnTogglePassword" title="Mostrar u ocultar contraseña" aria-label="Mostrar contraseña" aria-pressed="false">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="form-check">
                            <input asp-for="Input.Recordarme" class="form-check-input" id="rememberMeCheck" style="cursor: pointer;" />
                            <label class="form-check-label text-muted" for="rememberMeCheck" style="cursor: pointer; font-size: 0.9rem;">
                                Recordarme en este equipo
                            </label>
                        </div>
                        <a href="/Cuenta/OlvideContrasena" class="text-decoration-none fw-semibold" style="color: var(--sf-primary-olive, #2D4224); font-size: 0.9rem;">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button type="submit" id="btnSubmitLogin" class="btn-sign-in-primary">
                        Acceder al sistema
                    </button>
                </form>

                @if (HostEnvironment.IsDevelopment())
                {
                    <div class="or-divider-row">
                        <hr />
                        <span class="or-divider-text">Accesos directos de prueba</span>
                        <hr />
                    </div>

                    <div>
                        <button type="button" class="btn-demo-access btn-demo-role" data-role="admin" title="Cargar credenciales de Administrador">
                            <i class="fa-solid fa-user-shield me-2 text-success" aria-hidden="true"></i>
                            <span>Acceso directo (Administrador: Andrea Morales)</span>
                        </button>

                        <button type="button" class="btn-demo-access btn-demo-role" data-role="vendedor" title="Cargar credenciales de Vendedor">
                            <i class="fa-solid fa-user-tie me-2 text-primary" aria-hidden="true"></i>
                            <span>Acceso directo (Vendedor: Carlos Vega)</span>
                        </button>

                        <button type="button" class="btn-demo-access btn-demo-role" data-role="cajero" title="Cargar credenciales de Cajero">
                            <i class="fa-solid fa-cash-register me-2 text-warning" aria-hidden="true"></i>
                            <span>Acceso directo (Cajero: Luis Torres)</span>
                        </button>
                    </div>
                }

                <div class="mt-4 pt-3 text-muted border-top d-flex align-items-center justify-content-between" style="font-size: 0.8rem; border-color: #F1F5F9 !important;">
                    <span>Sistema Funerario</span>
                    <span><i class="fa-solid fa-location-dot me-1 text-secondary" aria-hidden="true"></i> Chihuahua, Chihuahua</span>
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/api/apiClient.js" asp-append-version="true"></script>
    <script src="~/js/api/authApi.js" asp-append-version="true"></script>
    <script src="~/js/pages/loginPage.js" asp-append-version="true"></script>
</body>
</html>
