@page
@model SistemaFuneraria.Web.Pages.Cuenta.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión - Sistema Funerario";
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5.3.8 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" onerror="this.onerror=null;this.href='/lib/bootstrap/dist/css/bootstrap.min.css';" />
    <!-- Font Awesome 7.3.1 (Cero SVGs inline) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        * {
            box-sizing: border-box;
        }
        body.login-page-body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #FFFFFF;
            color: #1E293B;
            overflow-x: hidden;
        }
        .login-main-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* ========================================================
           COLUMNA IZQUIERDA: HERO CON FOTO MEMORIAL (42% EXACTO)
           ======================================================== */
        .login-hero-column {
            flex: 0 0 42%;
            width: 42%;
            min-width: 400px;
            position: relative;
            background-color: #1B2B18;
            background-image: 
                linear-gradient(135deg, rgba(22, 38, 20, 0.82) 0%, rgba(12, 22, 11, 0.90) 100%),
                url('https://images.unsplash.com/photo-1518241353330-0f7941c2d9b5?auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 4rem 4.5rem;
            color: #FFFFFF;
        }
        .hero-top-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
            padding: 0.45rem 1.1rem;
            border-radius: 2rem;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.2);
            width: fit-content;
        }
        
        /* Contenedor Central con Frase Memorial y Opacidad */
        .hero-quote-container {
            max-width: 460px;
            margin: auto 0;
            padding: 2rem 0;
        }
        .hero-memorial-flower-icon {
            font-size: 2.2rem;
            color: #CCA352;
            opacity: 0.9;
            margin-bottom: 1.5rem;
        }
        .hero-quote-text {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 2.2rem;
            line-height: 1.35;
            font-style: italic;
            font-weight: 400;
            color: rgba(255, 255, 255, 0.94);
            margin-bottom: 1.5rem;
            letter-spacing: -0.01em;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
        }
        .hero-quote-author {
            font-size: 0.98rem;
            color: rgba(255, 255, 255, 0.8);
            line-height: 1.6;
            font-weight: 300;
        }

        .hero-footer-location {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            font-size: 0.88rem;
            color: rgba(255, 255, 255, 0.85);
            font-weight: 500;
        }

        /* ========================================================
           COLUMNA DERECHA: FORMULARIO INICIAR SESIÓN (58% RESTANTE)
           ======================================================== */
        .login-form-column {
            flex: 1;
            width: 58%;
            padding: 3.5rem 5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: #FFFFFF;
        }
        .login-form-inner-container {
            width: 100%;
            max-width: 500px;
        }
        .login-brand-header {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            margin-bottom: 2rem;
            text-decoration: none;
        }
        .login-brand-logo-icon {
            width: 44px;
            height: 44px;
            background-color: #2D4224;
            color: #CCA352;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            box-shadow: 0 4px 10px rgba(45, 66, 36, 0.18);
        }
        .login-brand-logo-text {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #2D4224;
        }
        .sign-in-title {
            font-size: 2.4rem;
            font-weight: 800;
            color: #111827;
            letter-spacing: -0.03em;
            margin-bottom: 0.4rem;
        }
        .sign-in-kicker {
            font-size: 0.95rem;
            color: #6B7280;
            margin-bottom: 2rem;
            font-weight: 500;
        }
        .sign-in-label {
            font-size: 0.88rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
            display: block;
        }
        .sign-in-input {
            width: 100%;
            border: 1px solid #D1D5DB;
            border-radius: 0.85rem;
            padding: 0.85rem 1.15rem;
            font-size: 1rem;
            color: #1F2937;
            background-color: #FFFFFF;
            transition: all 0.2s ease-in-out;
        }
        .sign-in-input:focus {
            outline: none;
            border-color: #2D4224;
            box-shadow: 0 0 0 3px rgba(45, 66, 36, 0.12);
        }
        .sign-in-input::placeholder {
            color: #9CA3AF;
        }
        .password-input-wrapper {
            position: relative;
        }
        .btn-eye-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #6B7280;
            cursor: pointer;
            padding: 0.35rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
        }
        .btn-eye-toggle:hover {
            color: #2D4224;
        }
        .btn-sign-in-primary {
            width: 100%;
            background-color: #2D4224 !important;
            border-color: #2D4224 !important;
            color: #FFFFFF !important;
            border: none;
            border-radius: 0.85rem;
            padding: 0.95rem 1.5rem;
            font-size: 1.05rem;
            font-weight: 600;
            margin-top: 1.5rem;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
        }
        .btn-sign-in-primary:hover:not(:disabled) {
            background-color: #22341B !important;
            box-shadow: 0 6px 16px rgba(45, 66, 36, 0.25);
        }
        .btn-sign-in-primary:disabled {
            background-color: #9CA3AF !important;
            cursor: not-allowed;
            opacity: 0.7;
        }
        .or-divider-row {
            display: flex;
            align-items: center;
            margin: 1.75rem 0 1.25rem 0;
        }
        .or-divider-row hr {
            flex-grow: 1;
            margin: 0;
            border: none;
            border-top: 1px solid #E5E7EB;
        }
        .or-divider-text {
            padding: 0 1rem;
            color: #9CA3AF;
            font-size: 0.8rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.05em;
        }

        /* Botones de Accesos Directos de Prueba Espaciosos */
        .btn-demo-access {
            width: 100%;
            border: 1px solid #E5E7EB;
            background: #FFFFFF;
            border-radius: 0.85rem;
            padding: 0.8rem 1.25rem;
            display: flex;
            align-items: center;
            font-size: 0.92rem;
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.65rem;
            transition: all 0.15s ease-in-out;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-demo-access:hover:not(:disabled) {
            background-color: #F9FAFB;
            border-color: #CBD5E1;
            transform: translateX(3px);
        }
        .btn-demo-access.active {
            border-color: #2D4224;
            background-color: #F0FDF4;
            color: #2D4224;
            font-weight: 600;
        }

        /* Responsividad */
        @@media (max-width: 992px) {
            .login-hero-column {
                display: none;
            }
            .login-form-column {
                width: 100%;
                padding: 3rem 1.75rem;
            }
        }
    </style>
</head>
<body class="login-page-body">
    <div class="login-main-wrapper">
        <!-- ========================================================
             COLUMNA IZQUIERDA: HERO MEMORIAL ESTÉTICO (LÍNEA ROJA A ~42%)
             ======================================================== -->
        <aside class="login-hero-column">
            <div>
                <div class="hero-top-badge">
                    <i class="fa-solid fa-leaf text-success"></i>
                    <span>Parque Memorial</span>
                </div>
            </div>

            <!-- Frase Solemne de Funeral con Opacidad y Estética -->
            <div class="hero-quote-container">
                <div class="hero-memorial-flower-icon">
                    <i class="fa-solid fa-dove"></i>
                </div>
                <blockquote class="hero-quote-text">
                    "Hay vidas que dejan huellas imborrables y recuerdos que florecen para siempre en el corazón."
                </blockquote>
                <p class="hero-quote-author">
                    Acompañamiento digno, calidez humana y certeza patrimonial para las familias en cada momento de trascendencia.
                </p>
            </div>

            <div class="hero-footer-location">
                <i class="fa-solid fa-location-dot"></i>
                <span>Chihuahua, Chihuahua</span>
            </div>
        </aside>

        <!-- ========================================================
             COLUMNA DERECHA: FORMULARIO INICIAR SESIÓN (58% RESTANTE)
             ======================================================== -->
        <main class="login-form-column">
            <div class="login-form-inner-container">
                <!-- Logotipo Funeraria -->
                <a href="/Cuenta/Login" class="login-brand-header">
                    <div class="login-brand-logo-icon">
                        <i class="fa-solid fa-monument"></i>
                    </div>
                    <span class="login-brand-logo-text">Sistema Funerario</span>
                </a>

                <!-- Título y Kicker -->
                <h1 class="sign-in-title">Iniciar sesión</h1>
                <p class="sign-in-kicker">Plataforma Operativa de Sucursal</p>

                <!-- Contenedor dinámico de alertas SF-028 (3.er intento: gold, 5.° intento: rose lockout) -->
                <div id="loginAlertContainer">
                    @if (!ModelState.IsValid && ViewData.ModelState["Input.Email"]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 rounded-3 py-2 small" role="alert">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <div>@ViewData.ModelState["Input.Email"]?.Errors[0].ErrorMessage</div>
                        </div>
                    }
                </div>

                <!-- Formulario -->
                <form id="loginForm" method="post" novalidate>
                    <!-- Correo Electrónico -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="sign-in-label">Correo electrónico</label>
                        <input asp-for="Input.Email" id="Input_Email" class="sign-in-input" placeholder="ejemplo@funeraria.mx" autocomplete="email" required />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Contraseña con Icono Ojo -->
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="sign-in-label">Contraseña</label>
                        <div class="password-input-wrapper">
                            <input asp-for="Input.Password" id="Input_Password" class="sign-in-input" placeholder="••••••••" autocomplete="current-password" required />
                            <button type="button" class="btn-eye-toggle" id="btnTogglePassword" title="Mostrar u ocultar contraseña">
                                <i class="fa-solid fa-eye-slash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Fila: Recordarme & ¿Olvidaste tu contraseña? -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="form-check">
                            <input asp-for="Input.Recordarme" class="form-check-input" id="rememberMeCheck" style="cursor: pointer;" />
                            <label class="form-check-label text-muted" for="rememberMeCheck" style="cursor: pointer; font-size: 0.9rem;">
                                Recordarme en este equipo
                            </label>
                        </div>
                        <a href="/Cuenta/OlvideContrasena" class="text-decoration-none fw-semibold" style="color: #2D4224; font-size: 0.9rem;">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <!-- Botón Acceder al sistema -->
                    <button type="submit" id="btnSubmitLogin" class="btn-sign-in-primary">
                        Acceder al sistema
                    </button>
                </form>

                <!-- Divisor Accesos Directos -->
                <div class="or-divider-row">
                    <hr />
                    <span class="or-divider-text">Accesos directos de prueba</span>
                    <hr />
                </div>

                <!-- Botones de Acceso Directo de Prueba (1-Clic) -->
                <div>
                    <!-- 1. Administrador: Andrea -->
                    <button type="button" class="btn-demo-access btn-demo-role" data-role="admin" onclick="cargarCredencialesDemo('admin')" title="Cargar credenciales de Administrador">
                        <i class="fa-solid fa-user-shield me-2 text-success"></i>
                        <span>Acceso directo (Administrador: Andrea)</span>
                    </button>

                    <!-- 2. Vendedor: Roberto -->
                    <button type="button" class="btn-demo-access btn-demo-role" data-role="vendedor" onclick="cargarCredencialesDemo('vendedor')" title="Cargar credenciales de Vendedor">
                        <i class="fa-solid fa-user-tie me-2 text-primary"></i>
                        <span>Acceso directo (Vendedor: Roberto)</span>
                    </button>

                    <!-- 3. Cajero de Sucursal -->
                    <button type="button" class="btn-demo-access btn-demo-role" data-role="cajero" onclick="cargarCredencialesDemo('cajero')" title="Cargar credenciales de Cajero">
                        <i class="fa-solid fa-cash-register me-2 text-warning"></i>
                        <span>Acceso directo (Cajero de Sucursal)</span>
                    </button>
                </div>

                <!-- Footer sutil -->
                <div class="mt-4 pt-3 text-muted border-top d-flex align-items-center justify-content-between" style="font-size: 0.8rem; border-color: #F1F5F9 !important;">
                    <span>Sistema Funerario</span>
                    <span><i class="fa-solid fa-location-dot me-1 text-secondary"></i> Chihuahua, Chihuahua</span>
                </div>
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function cargarCredencialesDemo(role) {
            var emailInput = document.getElementById('Input_Email');
            var passwordInput = document.getElementById('Input_Password');
            if (!emailInput || !passwordInput) return;

            if (role === 'admin') {
                emailInput.value = 'andrea.morales@funeraria.mx';
                passwordInput.value = 'Admin2026*';
            } else if (role === 'vendedor') {
                emailInput.value = 'roberto.mendez@funeraria.mx';
                passwordInput.value = 'Ventas2026*';
            } else if (role === 'cajero') {
                emailInput.value = 'cajero@funeraria.mx';
                passwordInput.value = 'Caja2026*';
            }
        }
    </script>
    <script src="~/js/pages/loginPage.js" asp-append-version="true"></script>
</body>
</html>
