@model SistemaFuneraria.Web.Pages.Ventas.NuevaModel

<div class="bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="step2Card">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Selecciona el lote</h2>
        <p class="small text-muted mb-0">Elige una opción disponible del inventario real para continuar.</p>
    </div>

    <!-- Alerta de error al consultar catálogo -->
    <div id="paso2AlertaError" class="alert alert-danger py-2 px-3 small d-none mb-3 rounded-3 d-flex justify-content-between align-items-center" role="alert">
        <span id="paso2MensajeError">No fue posible cargar los lotes disponibles.</span>
        <button type="button" id="btnReintentarLotesPaso2" class="btn btn-sm btn-outline-danger rounded-3 ms-2">Reintentar</button>
    </div>

    <!-- Lista vertical de tarjetas interactivas de lote (hidratada vía lotesApi.js) -->
    <div class="d-flex flex-column gap-3 mb-4" id="contenedorTarjetasLote" aria-live="polite">
        <div class="p-3 rounded-3 border bg-light placeholder-wave">
            <span class="placeholder col-3 rounded me-3"></span>
            <span class="placeholder col-5 rounded"></span>
        </div>
        <div class="p-3 rounded-3 border bg-light placeholder-wave">
            <span class="placeholder col-3 rounded me-3"></span>
            <span class="placeholder col-4 rounded"></span>
        </div>
        <div class="p-3 rounded-3 border bg-light placeholder-wave">
            <span class="placeholder col-3 rounded me-3"></span>
            <span class="placeholder col-5 rounded"></span>
        </div>
    </div>

    <!-- Botones de Navegación Inferior -->
    <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center">
        <button type="button" id="btnAnteriorPaso2" class="btn btn-outline-secondary rounded-3 px-4 py-2">
            Anterior
        </button>
        <button type="button"
                id="btnContinuarPaso2"
                class="btn text-white rounded-3 px-4 py-2 fw-medium d-inline-flex align-items-center shadow-sm"
                style="background-color: #2D4224; border-color: #2D4224;"
                disabled>
            Continuar <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
        </button>
    </div>
</div>
