@model SistemaFuneraria.Web.Pages.Ventas.NuevaModel

<div class="bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="step4Card">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Confirma la operación</h2>
        <p class="small text-muted mb-0">Revisa la información antes de generar el contrato.</p>
    </div>

    <!-- 2. Grid 2x2 de Tarjetas de Resumen -->
    <div class="row g-3 mb-4">
        <!-- Tarjeta 1: Cliente -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Cliente</small>
                <div class="fw-bold text-dark fs-6" id="resumenClienteNombre">Mariana Torres Aguirre</div>
                <small class="text-muted" id="resumenClienteEmail">mariana.torres@email.mx</small>
            </div>
        </div>

        <!-- Tarjeta 2: Lote -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Lote</small>
                <div class="fw-bold text-dark fs-6" id="resumenLoteClaveYJardin">JN-A-042 · Jardín Norte</div>
                <small class="text-muted" id="resumenLoteCapacidad">2 gavetas</small>
            </div>
        </div>

        <!-- Tarjeta 3: Precio -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Precio</small>
                <div class="fw-bold text-dark fs-6 sf-money" id="resumenPrecioTotal">$120,000.00</div>
                <small class="text-muted" id="resumenPrecioEnganche">Enganche de $24,000.00</small>
            </div>
        </div>

        <!-- Tarjeta 4: Financiamiento -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Financiamiento</small>
                <div class="fw-bold text-dark fs-6 sf-money" id="resumenPlanDetalle">24 pagos de $4,887.54</div>
                <small class="text-muted" id="resumenPlanTasa">Tasa anual fija del 20%</small>
            </div>
        </div>
    </div>

    <!-- 3. Checkbox de Confirmación con el Cliente -->
    <div class="form-check my-4">
        <input class="form-check-input sf-checkbox-olive" type="checkbox" id="chkConfirmarDatos" style="cursor: pointer;" />
        <label class="form-check-label text-dark fw-medium small ms-2" for="chkConfirmarDatos" style="cursor: pointer;">
            Confirmo que los datos fueron revisados con el cliente.
        </label>
    </div>

    <!-- Mensaje de éxito / alerta al generar -->
    <div id="alertaExitoContrato" class="alert alert-success py-3 px-4 d-none rounded-3 shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="fa-solid fa-circle-check fs-4 text-success me-3" aria-hidden="true"></i>
            <div>
                <div class="fw-bold text-dark">¡Contrato generado con éxito!</div>
                <div class="small text-muted" id="lblFolioGenerado">Folio asignado: <strong>CTR-2026-0190</strong></div>
            </div>
        </div>
    </div>

    <!-- 4. Botones de Acción al Pie -->
    <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center">
        <button type="button" id="btnAnteriorPaso4" class="btn btn-outline-secondary rounded-3 px-4 py-2">
            Anterior
        </button>
        <button type="button"
                id="btnGenerarContrato"
                class="btn text-white rounded-3 px-4 py-2 fw-medium shadow-sm d-inline-flex align-items-center"
                style="background-color: #2D4224; border-color: #2D4224;"
                disabled>
            <i class="fa-solid fa-check me-2" aria-hidden="true"></i> Generar contrato
        </button>
    </div>
</div>
