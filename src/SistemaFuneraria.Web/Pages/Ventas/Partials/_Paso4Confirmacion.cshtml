@model SistemaFuneraria.Web.Pages.Ventas.NuevaModel

<div class="bg-white rounded-4 shadow-sm border p-4 p-md-5 d-none" id="step4Card">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Confirma la operación</h2>
        <p class="small text-muted mb-0">Revisa la información antes de generar el contrato.</p>
    </div>

    <!-- 2. Grid 2x2 de Tarjetas de Resumen -->
    <div class="row g-3 mb-4">
        <!-- Tarjeta 1: Cliente -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Cliente</small>
                <div class="fw-bold text-dark fs-6" id="resumenClienteNombre">-</div>
                <small class="text-muted" id="resumenClienteEmail">-</small>
            </div>
        </div>

        <!-- Tarjeta 2: Lote -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Lote</small>
                <div class="fw-bold text-dark fs-6" id="resumenLoteClaveYJardin">-</div>
                <small class="text-muted" id="resumenLoteCapacidad">- gavetas</small>
            </div>
        </div>

        <!-- Tarjeta 3: Precio -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Precio</small>
                <div class="fw-bold text-dark fs-6 sf-money" id="resumenPrecioTotal">$0.00</div>
                <small class="text-muted" id="resumenPrecioEnganche">-</small>
            </div>
        </div>

        <!-- Tarjeta 4: Financiamiento -->
        <div class="col-12 col-md-6">
            <div class="p-3 rounded-3 border h-100" style="background-color: #FAF8F5; border-color: #F0ECE1 !important;">
                <small class="text-muted fw-medium d-block mb-1">Financiamiento</small>
                <div class="fw-bold text-dark fs-6 sf-money" id="resumenPlanDetalle">-</div>
                <small class="text-muted" id="resumenPlanTasa">-</small>
            </div>
        </div>
    </div>

    <!-- Método y referencia para venta en Contado (SF-062) -->
    <div id="contenedorPagoContado" class="row g-3 mb-4 d-none">
        <div class="col-12 col-md-6">
            <label for="selectMetodoPagoContado" class="form-label small fw-medium text-dark">Método de pago</label>
            <select id="selectMetodoPagoContado" class="form-select rounded-3 py-2">
                <option value="Efectivo" selected>Efectivo</option>
                <option value="Tarjeta">Tarjeta</option>
                <option value="TransferenciaBancaria">Transferencia bancaria</option>
            </select>
        </div>
        <div class="col-12 col-md-6">
            <label for="txtReferenciaPagoContado" class="form-label small fw-medium text-dark">Referencia (opcional)</label>
            <input type="text"
                   id="txtReferenciaPagoContado"
                   class="form-control rounded-3 py-2"
                   placeholder="Ej. Folio de transferencia o voucher"
                   maxlength="100" />
        </div>
    </div>

    <!-- 3. Firma Digital de Conformidad del Cliente -->
    <div id="seccionFirmaCliente" class="rounded-4 border p-3 p-md-4 my-4" style="background-color: #FAF8F5; border-color: #E8E3D9 !important;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-signature text-success" aria-hidden="true"></i>
                <span class="fw-semibold text-dark small">Firma de conformidad del cliente</span>
                <span id="badgeEstadoFirma" class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1" style="font-size: 0.72rem;">
                    Pendiente
                </span>
            </div>
            <button type="button" id="btnLimpiarFirmaCliente" class="btn btn-sm btn-outline-secondary rounded-3 px-2 py-1">
                <i class="fa-solid fa-eraser me-1" aria-hidden="true"></i> Limpiar firma
            </button>
        </div>

        <div class="sf-signature-pad-wrap position-relative rounded-3 bg-white border">
            <canvas id="canvasFirmaCliente"
                    class="sf-signature-canvas w-100 d-block"
                    aria-label="Área de firma digital del cliente"></canvas>
            <div id="firmaClientePlaceholder" class="sf-signature-placeholder">
                <i class="fa-solid fa-pen-nib me-1" aria-hidden="true"></i> Firme aquí dentro del recuadro
            </div>
            <div class="sf-signature-baseline" aria-hidden="true"></div>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-1 mt-2 small text-muted">
            <span><strong>Titular:</strong> <span id="firmaClienteNombrePreview">-</span></span>
            <span><i class="fa-solid fa-shield-check text-success me-1" aria-hidden="true"></i><strong>Sello de vendedor:</strong> <span id="firmaVendedorPreview">Sesión autenticada</span></span>
        </div>
    </div>

    <!-- 4. Checkbox de Confirmación con el Cliente -->
    <div class="form-check my-3">
        <input class="form-check-input sf-checkbox-olive" type="checkbox" id="chkConfirmarDatos" style="cursor: pointer;" />
        <label class="form-check-label text-dark fw-medium small ms-2" for="chkConfirmarDatos" style="cursor: pointer;">
            Confirmo que los datos fueron revisados y aceptados con el cliente.
        </label>
    </div>

    <!-- Alerta de error o conflicto de lote (409 Conflict) -->
    <div id="alertaErrorContrato" class="alert alert-danger py-3 px-4 d-none rounded-3 shadow-sm mb-4" role="alert">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-danger" aria-hidden="true"></i>
                <span class="small fw-medium" id="lblErrorContrato">Ocurrió un error al generar el contrato.</span>
            </div>
            <button type="button" id="btnElegirOtroLote" class="btn btn-sm btn-outline-danger rounded-3 d-none text-nowrap">
                Elegir otro lote
            </button>
        </div>
    </div>

    <!-- Mensaje de éxito al generar -->
    <div id="alertaExitoContrato" class="alert alert-success py-3 px-4 d-none rounded-3 shadow-sm mb-4" role="alert">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-circle-check fs-4 text-success me-3" aria-hidden="true"></i>
                <div>
                    <div class="fw-bold text-dark">¡Contrato generado con éxito!</div>
                    <div class="small text-muted" id="lblFolioGenerado">Folio asignado</div>
                </div>
            </div>
            <a href="/Contratos/Detalle" id="lnkVerContratoGenerado" class="btn btn-sm btn-success rounded-3 px-3 text-nowrap">
                Ver contrato e imprimir
            </a>
        </div>
    </div>

    <!-- 4. Botones de Acción al Pie -->
    <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center">
        <button type="button" id="btnAnteriorPaso4" class="btn btn-outline-secondary rounded-3 px-4 py-2">
            Anterior
        </button>
        <button type="button"
                id="btnGenerarContrato"
                class="btn text-white rounded-3 px-4 py-2 fw-medium shadow-sm d-inline-flex align-items-center"
                style="background-color: #2D4224; border-color: #2D4224;"
                disabled>
            <i class="fa-solid fa-check me-2" aria-hidden="true"></i> Generar contrato
        </button>
    </div>
</div>
