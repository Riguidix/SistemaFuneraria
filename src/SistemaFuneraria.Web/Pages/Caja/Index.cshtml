@page
@model SistemaFuneraria.Web.Pages.Caja.IndexModel
@{
    ViewData["Title"] = "Caja y cobranza - Operación Diaria";
}

<!-- Estado de Acceso Restringido (403 Forbidden) -->
<div id="cajaAccesoRestringido" class="card border-0 shadow-sm rounded-4 p-5 text-center mb-4 d-none" role="alert">
    <div class="py-3">
        <i class="fa-solid fa-lock fa-2x text-danger mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark mb-2">Acceso restringido (403)</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 460px;">
            Tu rol actual no tiene permisos para operar ventanilla de Caja. Esta sección está disponible para <strong>Administrador</strong> y <strong>Cajero</strong>.
        </p>
        <a id="btnVolver403Caja" href="/Resumen" class="btn btn-funeraria-primary rounded-3 px-4">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver a mi inicio
        </a>
    </div>
</div>

<div id="cajaContenidoPrincipal">
<!-- ========================================================
     1. ENCABEZADO DE PÁGINA (Figma Captura 10)
     ======================================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="text-uppercase fw-bold text-muted small" style="letter-spacing: 0.08em; font-size: 0.75rem;">OPERACIÓN DIARIA</span>
        <h1 class="fw-bold mt-1 mb-1" style="color: var(--sf-text-dark, #1F2937); font-size: 2.25rem; letter-spacing: -0.02em;">Caja y cobranza</h1>
        <p class="text-muted mb-0" style="font-size: 1rem;">Registra pagos, abonos a capital y liquidaciones anticipadas.</p>
    </div>

    <!-- Badge de Estado de Caja (Pill Superior Derecha) -->
    <div class="d-inline-flex align-items-center gap-2 bg-white px-3 py-2 rounded-4 border shadow-sm" style="min-width: 170px;">
        <span class="rounded-circle" style="width: 10px; height: 10px; background-color: #10B981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);" aria-hidden="true"></span>
        <div class="d-flex flex-column">
            <span class="fw-bold text-dark" style="font-size: 0.85rem; line-height: 1.15;">Caja abierta</span>
            <span id="horaAperturaCaja" class="text-muted" style="font-size: 0.72rem; line-height: 1.15;">Turno activo</span>
        </div>
    </div>
</div>

<!-- ========================================================
     2. GRID PRINCIPAL DE 2 COLUMNAS (Figma Captura 10)
     ======================================================== -->
<div class="row g-4">
    <!-- ====================================================
         COLUMNA IZQUIERDA: Panel "Registrar movimiento" (SF-080 & SF-081)
         ==================================================== -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="mb-4">
                <h2 class="h5 fw-bold mb-1" style="color: var(--sf-text-dark, #1F2937);">Registrar movimiento</h2>
                <p class="text-muted small mb-0">Localiza el contrato para aplicar un pago.</p>
            </div>

            <!-- Buscador de Contrato -->
            <div class="position-relative mb-4">
                <div class="input-group input-group-lg rounded-3 overflow-hidden border">
                    <span class="input-group-text bg-white border-0 ps-3 pe-2 text-muted" aria-hidden="true">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text"
                           id="inputBuscadorContrato"
                           class="form-control border-0 ps-1 py-3 text-dark fw-medium"
                           placeholder="Buscar por folio de contrato (ej. CTR-2025-0189)..."
                           value="@Model.FolioContrato"
                           aria-label="Localizar contrato por folio"
                           autocomplete="off" />
                    <button type="button"
                            id="btnLimpiarBuscador"
                            class="btn bg-white border-0 text-muted px-3"
                            aria-label="Limpiar búsqueda"
                            title="Limpiar búsqueda">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                    <button type="button"
                            id="btnBuscarContratoCaja"
                            class="btn btn-light border-0 border-start text-dark fw-semibold px-3 fs-6"
                            aria-label="Buscar contrato">
                        Buscar
                    </button>
                </div>
            </div>

            <!-- Placeholder Inicial sin Contrato Seleccionado -->
            <div id="estadoSinContratoCaja" class="p-3 mb-4 rounded-3 text-muted small border bg-light bg-opacity-50 d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-info text-muted" aria-hidden="true"></i>
                <span>Ingresa un folio de contrato (ej. CTR-2025-0189) para cargar su saldo y aplicar pagos.</span>
            </div>

            <!-- Tarjeta de Cliente Localizado -->
            <div id="cardClienteLocalizado" class="p-3 mb-4 rounded-3 d-none" style="background-color: #FAF8F5; border: 1px solid #EBE5DC;">
                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                             style="width: 48px; height: 48px; background-color: #D3C3A8; color: #4B3F2F; font-size: 1rem; flex-shrink: 0;"
                             id="avatarCliente">
                            —
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6" id="nombreCliente">—</div>
                            <div class="text-muted small" id="detalleContrato">—</div>
                        </div>
                    </div>
                    <div>
                        <span class="badge rounded-pill fw-semibold px-3 py-2"
                              id="badgeEstadoCliente"
                              style="background-color: #E8F5E9; color: #1B5E20; border: 1px solid #A7F3D0; font-size: 0.8rem;">
                            —
                        </span>
                    </div>
                </div>
            </div>

            <!-- Selector de Tipo de Movimiento (3 Tarjetas Interactivas) -->
            <div class="row g-3 mb-4" role="group" aria-label="Tipo de movimiento de caja">
                <!-- 1. Mensualidad (Pago ordinario) -->
                <div class="col-12 col-md-4">
                    <div id="cardOpcionMensualidad"
                         role="button"
                         tabindex="0"
                         aria-pressed="true"
                         class="card-movimiento active h-100 p-3 rounded-3">
                        <i class="fa-solid fa-credit-card fs-5 mb-2 icono-movimiento" aria-hidden="true"></i>
                        <div class="fw-bold titulo-movimiento">Mensualidad</div>
                        <div class="text-muted small subtitulo-movimiento">Pago ordinario</div>
                    </div>
                </div>

                <!-- 2. Abono a capital (Reduce mensualidad) -->
                <div class="col-12 col-md-4">
                    <div id="cardOpcionAbono"
                         role="button"
                         tabindex="0"
                         aria-pressed="false"
                         class="card-movimiento h-100 p-3 rounded-3">
                        <i class="fa-solid fa-arrow-trend-down fs-5 mb-2 icono-movimiento" aria-hidden="true"></i>
                        <div class="fw-bold titulo-movimiento">Abono a capital</div>
                        <div class="text-muted small subtitulo-movimiento">Reduce mensualidad</div>
                    </div>
                </div>

                <!-- 3. Liquidación (Cierre anticipado) -->
                <div class="col-12 col-md-4">
                    <div id="cardOpcionLiquidacion"
                         role="button"
                         tabindex="0"
                         aria-pressed="false"
                         class="card-movimiento h-100 p-3 rounded-3">
                        <i class="fa-solid fa-check fs-5 mb-2 icono-movimiento" aria-hidden="true"></i>
                        <div class="fw-bold titulo-movimiento">Liquidación</div>
                        <div class="text-muted small subtitulo-movimiento">Cierre anticipado</div>
                    </div>
                </div>
            </div>

            <!-- ========================================================
                 FORMULARIO INFERIOR DE COBRO (SF-081)
                 ======================================================== -->
            <form id="formAplicarPago">
                <div class="row g-3 mb-3">
                    <!-- 1. Importe a recibir -->
                    <div class="col-12 col-md-6">
                        <label for="inputImporteRecibir" class="form-label text-muted small fw-medium mb-1">Importe a recibir</label>
                        <input type="text"
                               id="inputImporteRecibir"
                               class="form-control form-control-lg sf-money fw-bold text-dark rounded-3"
                               value="$0.00"
                               readonly />
                    </div>

                    <!-- 2. Método de pago -->
                    <div class="col-12 col-md-6">
                        <label for="selectMetodoPago" class="form-label text-muted small fw-medium mb-1">Método de pago</label>
                        <select id="selectMetodoPago" class="form-select form-select-lg rounded-3 text-dark fw-medium">
                            <option value="TransferenciaBancaria" selected>Transferencia bancaria</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Tarjeta">Tarjeta de débito / crédito</option>
                        </select>
                    </div>
                </div>

                <!-- 3. Referencia -->
                <div class="mb-4">
                    <label for="inputReferencia" class="form-label text-muted small fw-medium mb-1">
                        Referencia <span id="asteriscoReferenciaCaja" class="text-danger">*</span>
                    </label>
                    <input type="text"
                           id="inputReferencia"
                           class="form-control form-control-lg rounded-3"
                           placeholder="Folio o últimos 4 dígitos" />
                    <small id="ayudaReferenciaCaja" class="text-muted d-block mt-1">Obligatoria para transferencia o tarjeta (mín. 4 caracteres).</small>
                </div>

                <!-- Botón de Acción Principal -->
                <button type="submit"
                        id="btnAplicarPago"
                        disabled
                        class="btn w-100 py-3 rounded-3 fw-bold shadow-sm d-flex align-items-center justify-content-center"
                        style="background-color: #2D4224; color: #ffffff; border: none; font-size: 1.05rem;">
                    <span id="iconoBtnAplicarPago" class="me-2"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
                    <span id="textoBtnAplicarPago">Selecciona un contrato para cobrar</span>
                </button>
            </form>

            <!-- Alerta Error Dinámica -->
            <div id="alertaErrorCaja" class="alert alert-danger d-none rounded-4 shadow-sm mt-4 small" role="alert"></div>

            <!-- Alerta Éxito Dinámica -->
            <div id="alertaPagoExitoso" class="alert alert-success d-none rounded-4 shadow-sm mt-4 border-0" role="alert" style="background-color: #E8F5E9; color: #1B5E20;">
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check fs-4 text-success" aria-hidden="true"></i>
                        <div>
                            <strong id="textoPagoExitoso">¡Pago registrado exitosamente!</strong>
                            <div class="small" id="subtextoPagoExitoso">Comprobante oficial emitido. Saldo de la cuota actualizado.</div>
                            <a href="#" id="lnkVerReciboPago" class="small fw-semibold text-success d-none">
                                Ver e imprimir recibo oficial <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar alerta" onclick="document.getElementById('alertaPagoExitoso').classList.add('d-none');"></button>
                </div>
            </div>
        </div>
    </div>

    <!-- ====================================================
         COLUMNA DERECHA: Panel de Métricas y Control (SF-081)
         ==================================================== -->
    <div class="col-12 col-lg-4">
        <!-- Card 1: Corte del día -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="mb-4">
                <h2 class="h5 fw-bold mb-1" style="color: var(--sf-text-dark, #1F2937);">Corte del día</h2>
                <p class="text-muted small mb-0" id="fechaCorteDia">Operación del día</p>
            </div>

            <!-- Lista de métricas financieras tabulares (.sf-money) -->
            <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <span>Saldo inicial</span>
                    <span class="sf-money text-dark fw-semibold" id="montoSaldoInicial">—</span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <span>Pagos recibidos</span>
                    <span class="fw-semibold text-dark" id="contadorPagosRecibidos">—</span>
                </div>
                <div class="d-flex justify-content-between align-items-center text-muted small">
                    <span>Ingresos del día</span>
                    <span class="sf-money text-dark fw-semibold" id="montoIngresosDia">—</span>
                </div>
            </div>

            <hr class="my-3 text-muted opacity-25" />

            <!-- Total destacado en caja -->
            <div class="d-flex justify-content-between align-items-baseline mb-4">
                <span class="text-muted fw-medium">Total en caja</span>
                <span class="h4 fw-bold text-success sf-money mb-0" id="montoTotalCaja">—</span>
            </div>

            <!-- Botón de acción: Preparar corte -->
            <button type="button"
                    class="btn btn-outline-secondary w-100 py-2 rounded-3 fw-medium"
                    onclick="window.print();">
                Preparar corte
            </button>
        </div>

        <!-- Card 2: Alerta "Pagos que requieren atención" -->
        <div class="card bg-warning-subtle border border-warning-subtle rounded-4 p-4 shadow-sm">
            <div class="d-flex align-items-start gap-3">
                <i class="fa-solid fa-triangle-exclamation text-warning fs-4 me-2 mt-1" aria-hidden="true"></i>
                <div>
                    <h3 class="h6 fw-bold text-dark mb-1" id="tituloPagosAtencion">Verificando vencimientos...</h3>
                    <p class="small text-muted mb-3">Contacta a los clientes con mensualidades vencidas para mantener la cartera al corriente.</p>
                    <a href="/Contratos?tab=Vencidos" class="text-decoration-none fw-semibold" style="color: #2D4224;">
                        Revisar cartera vencida <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<style>
    /* Estilos de las 3 Tarjetas de Selección de Movimiento */
    .card-movimiento {
        background-color: #FFFFFF;
        border: 1px solid #E5E7EB;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

    .card-movimiento:hover {
        border-color: #2D4224;
        background-color: #FAFBF9;
    }

    .card-movimiento.active {
        border: 2px solid #2D4224 !important;
        background-color: #F4F7F2 !important;
    }

    .card-movimiento .icono-movimiento {
        color: #6B7280;
        transition: color 0.2s ease;
    }

    .card-movimiento.active .icono-movimiento {
        color: #2D4224;
    }

    .card-movimiento .titulo-movimiento {
        color: #1F2937;
        font-size: 0.95rem;
    }

    .card-movimiento.active .titulo-movimiento {
        color: #2D4224;
    }
</style>

<!-- ========================================================
     CONEXIÓN CON COBRANZA API, IDEMPOTENCIA Y CORTE REAL (SF-079 / SF-080 / SF-081)
     ======================================================== -->
@section Scripts {
    <script src="~/js/api/cobranzaApi.js" asp-append-version="true"></script>
    <script src="~/js/pages/cajaPage.js" asp-append-version="true"></script>
}
