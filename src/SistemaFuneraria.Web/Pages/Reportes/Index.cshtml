@page
@model SistemaFuneraria.Web.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes y Analítica";
}

<!-- ========================================================
     ENCABEZADO DE PÁGINA (FIGMA CAPTURA 11 · SF-090)
     ======================================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="text-uppercase fw-semibold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">
            ANALÍTICA
        </div>
        <h1 class="h2 fw-bold text-dark mb-1">
            Reportes
        </h1>
        <p class="text-muted mb-0 small">
            Indicadores comerciales, cobranza y desempeño por periodo.
        </p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center shadow-sm" id="btnDescargarReporte">
            <i class="fa-solid fa-file-arrow-down me-2" aria-hidden="true"></i> Descargar reporte
        </button>
    </div>
</div>

<!-- ========================================================
     BARRA DE FILTROS: PERIODO Y SUCURSAL
     ======================================================== -->
<div class="d-flex flex-wrap gap-3 align-items-center mb-4 p-3 bg-white rounded-4 shadow-sm border">
    <!-- Filtro Periodo -->
    <div class="d-flex align-items-center gap-2">
        <label for="selectPeriodo" class="small fw-semibold text-muted text-nowrap mb-0">Periodo:</label>
        <select id="selectPeriodo" class="form-select form-select-sm rounded-3 border-secondary-subtle fw-medium" style="min-width: 170px;">
            <option selected>Noviembre 2025</option>
            <option>Octubre 2025</option>
            <option>Septiembre 2025</option>
            <option>Tercer Trimestre 2025</option>
            <option>Año 2025</option>
        </select>
    </div>

    <!-- Divisor sutil en pantallas medianas -->
    <div class="d-none d-sm-block border-start h-100 py-2"></div>

    <!-- Filtro Sucursal -->
    <div class="d-flex align-items-center gap-2">
        <label for="selectSucursal" class="small fw-semibold text-muted text-nowrap mb-0">Sucursal:</label>
        <select id="selectSucursal" class="form-select form-select-sm rounded-3 border-secondary-subtle fw-medium" style="min-width: 190px;">
            <option selected>Jardines del Valle</option>
            <option>Todas las sucursales</option>
        </select>
    </div>
</div>

<!-- ========================================================
     FILA SUPERIOR: 3 TARJETAS KPI (ROW G-3 MB-4)
     ======================================================== -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Conversión de cotización -->
    <div class="col-12 col-md-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Conversión de cotización</span>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 40px; height: 40px; background-color: #EBF5EB;">
                    <i class="fa-solid fa-chart-pie text-success fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1">
                    @Model.ConversionCotizacion.ToString("0.0")%
                </div>
                <div class="text-success small fw-semibold d-flex align-items-center">
                    <i class="fa-solid fa-arrow-trend-up me-1" aria-hidden="true"></i>
                    @Model.ConversionComparativa
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Ticket promedio -->
    <div class="col-12 col-md-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Ticket promedio</span>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 40px; height: 40px; background-color: #E8F0FE;">
                    <i class="fa-solid fa-receipt text-primary fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1">
                    $@Model.TicketPromedio.ToString("#,##0")
                </div>
                <div class="text-muted small fw-medium">
                    @Model.TicketSubtexto
                </div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Índice de morosidad -->
    <div class="col-12 col-md-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Índice de morosidad</span>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 40px; height: 40px; background-color: #FEF7E6;">
                    <i class="fa-solid fa-triangle-exclamation text-warning fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1">
                    @Model.IndiceMorosidad.ToString("0.0")%
                </div>
                <div class="text-success small fw-semibold d-flex align-items-center">
                    <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                    @Model.MorosidadMeta
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     FILA INFERIOR: 2 TARJETAS ANALÍTICAS PRINCIPALES
     ======================================================== -->
<div class="row g-4 mb-4">
    <!-- Tarjeta Izquierda (col-lg-7): Ventas por tipo de lote -->
    <div class="col-12 col-lg-7">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <!-- Header de Tarjeta -->
            <div class="mb-4">
                <h2 class="h5 fw-bold text-dark mb-1">Ventas por tipo de lote</h2>
                <p class="text-muted small mb-0">Participación en ingresos del mes.</p>
            </div>

            <!-- Lista de Barras de Progreso Horizontales -->
            <div class="d-flex flex-column justify-content-around flex-grow-1">
                @foreach (var item in Model.VentasPorTipoLote)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold text-dark">@item.TipoLote</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small text-muted">@item.Porcentaje%</span>
                                <span class="fw-bold sf-money text-dark">$@item.Monto.ToString("#,##0")</span>
                            </div>
                        </div>
                        <div class="progress rounded-pill" style="height: 12px; background-color: #EFECE6;">
                            <div class="progress-bar rounded-pill" role="progressbar"
                                 style="width: @(item.Porcentaje)%; background-color: #2D4224; transition: width 0.6s ease;"
                                 aria-valuenow="@item.Porcentaje" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Nota al pie informativa -->
            <div class="border-top border-light-subtle pt-3 mt-3 d-flex justify-content-between align-items-center small text-muted">
                <span>Total ingresos registrados</span>
                <span class="fw-bold text-dark sf-money">$@Model.VentasPorTipoLote.Sum(x => x.Monto).ToString("#,##0")</span>
            </div>
        </div>
    </div>

    <!-- Tarjeta Derecha (col-lg-5): Meta mensual -->
    <div class="col-12 col-lg-5">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <!-- Header de Tarjeta -->
            <div class="mb-3">
                <h2 class="h5 fw-bold text-dark mb-1">Meta mensual</h2>
                <p class="text-muted small mb-0">Avance comercial de noviembre.</p>
            </div>

            <!-- Gráfica de Dona Circular (81%) -->
            <div class="d-flex justify-content-center my-3">
                <div class="sf-donut-meta position-relative rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 154px; height: 154px; background: conic-gradient(#2D4224 0% @(Model.PorcentajeCumplimientoMeta)%, #E5E0D8 @(Model.PorcentajeCumplimientoMeta)% 100%);">
                    <!-- Agujero interior blanco de la dona -->
                    <div class="bg-white rounded-circle d-flex flex-column align-items-center justify-content-center shadow-sm"
                         style="width: 106px; height: 106px;">
                        <span class="display-5 fw-bold text-dark sf-money lh-1">@Model.PorcentajeCumplimientoMeta%</span>
                        <span class="small text-muted fw-semibold mt-1" style="font-size: 0.75rem;">de la meta</span>
                    </div>
                </div>
            </div>

            <!-- Métricas de Resumen Inferiores -->
            <div class="border-top border-light-subtle pt-3 mt-3">
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted small">Acumulado</span>
                    <span class="fw-bold text-success sf-money fs-6">$@Model.AcumuladoMes.ToString("#,##0")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted small">Objetivo mensual</span>
                    <span class="fw-bold text-dark sf-money fs-6">$@Model.ObjetivoMensual.ToString("#,##0")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos auxiliares para la vista de Reportes y Analítica */
    .sf-donut-meta {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .sf-donut-meta:hover {
        transform: scale(1.03);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
    }
</style>
