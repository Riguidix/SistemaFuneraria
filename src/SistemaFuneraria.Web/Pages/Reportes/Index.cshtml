@page
@model SistemaFuneraria.Web.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes y Analítica";
}

<!-- Estado de Acceso Restringido (403 Forbidden) -->
<div id="reportesAccesoRestringido" class="card border-0 shadow-sm rounded-4 p-5 text-center mb-4 d-none" role="alert">
    <div class="py-3">
        <i class="fa-solid fa-lock fa-2x text-danger mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark mb-2">Acceso restringido (403)</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 460px;">
            Tu rol actual no tiene permisos para consultar los indicadores analíticos. Esta sección es exclusiva del rol <strong>Administrador</strong>.
        </p>
        <a id="btnVolver403Reportes" href="/Resumen" class="btn btn-funeraria-primary rounded-3 px-4">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver a mi inicio
        </a>
    </div>
</div>

<div id="reportesContenidoPrincipal">
<!-- ========================================================
     ENCABEZADO DE PÁGINA (FIGMA CAPTURA 11 · SF-090)
     ======================================================== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="text-uppercase fw-semibold small text-muted mb-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">
            ANALÍTICA
        </div>
        <h1 class="h2 fw-bold text-dark mb-1">
            Reportes
        </h1>
        <p class="text-muted mb-0 small">
            Indicadores comerciales, cobranza y desempeño por periodo.
        </p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center shadow-sm" id="btnDescargarReporte" disabled>
            <i class="fa-solid fa-file-arrow-down me-2" aria-hidden="true"></i> Descargar reporte
        </button>
    </div>
</div>

<!-- Banner de Error Dinámico -->
<div id="alertaErrorReportes" class="alert alert-danger d-none rounded-4 shadow-sm mb-4 small" role="alert">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span id="mensajeErrorReportes">No fue posible cargar los indicadores de reportes.</span>
        <button type="button" id="btnReintentarReportes" class="btn btn-sm btn-outline-danger rounded-3 fw-semibold">
            <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i> Reintentar
        </button>
    </div>
</div>

<!-- ========================================================
     BARRA DE FILTROS: PERIODO Y SUCURSAL
     ======================================================== -->
<div class="d-flex flex-wrap gap-3 align-items-center mb-4 p-3 bg-white rounded-4 shadow-sm border">
    <!-- Filtro Periodo -->
    <div class="d-flex align-items-center gap-2">
        <label for="selectPeriodo" class="small fw-semibold text-muted text-nowrap mb-0">Periodo:</label>
        <select id="selectPeriodo" class="form-select form-select-sm rounded-3 border-secondary-subtle fw-medium" style="min-width: 190px;">
            <option value="mes-actual" selected>Mes actual</option>
            <option value="mes-anterior">Mes anterior</option>
            <option value="trimestre-actual">Trimestre actual</option>
            <option value="anio-actual">Año en curso</option>
            <option value="historico">Histórico completo</option>
        </select>
    </div>

    <!-- Divisor sutil en pantallas medianas -->
    <div class="d-none d-sm-block border-start h-100 py-2"></div>

    <!-- Filtro Sucursal -->
    <div class="d-flex align-items-center gap-2">
        <label for="selectSucursal" class="small fw-semibold text-muted text-nowrap mb-0">Sucursal:</label>
        <select id="selectSucursal" class="form-select form-select-sm rounded-3 border-secondary-subtle fw-medium" style="min-width: 190px;">
            <option value="Jardines del Valle" selected>Jardines del Valle</option>
            <option value="Todas las sucursales">Todas las sucursales</option>
        </select>
    </div>
</div>

<!-- ========================================================
     FILA SUPERIOR: 3 TARJETAS KPI (ROW G-3 MB-4)
     ======================================================== -->
<div class="row g-3 mb-4">
    <!-- KPI 1: Conversión de cotización -->
    <div class="col-12 col-md-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Conversión de cotización</span>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 40px; height: 40px; background-color: #EBF5EB;">
                    <i class="fa-solid fa-chart-pie text-success fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1" id="kpiConversion">—</div>
                <div class="text-muted small fw-medium" id="subtituloConversion">Relación ventas / clientes</div>
            </div>
        </div>
    </div>

    <!-- KPI 2: Ticket promedio -->
    <div class="col-12 col-md-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Ticket promedio</span>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 40px; height: 40px; background-color: #E8F0FE;">
                    <i class="fa-solid fa-receipt text-primary fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1" id="kpiTicketPromedio">—</div>
                <div class="text-muted small fw-medium" id="subtituloTicket">Promedio por operación</div>
            </div>
        </div>
    </div>

    <!-- KPI 3: Índice de morosidad -->
    <div class="col-12 col-md-4">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="small text-muted fw-semibold text-uppercase" style="letter-spacing: 0.04em;">Índice de morosidad</span>
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 40px; height: 40px; background-color: #FEF7E6;">
                    <i class="fa-solid fa-triangle-exclamation text-warning fs-5" aria-hidden="true"></i>
                </div>
            </div>
            <div>
                <div class="display-6 fw-bold text-dark sf-money mb-1" id="kpiIndiceMorosidad">—</div>
                <div class="text-success small fw-semibold d-flex align-items-center" id="subtituloMorosidad">
                    <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                    Meta menor a 8.0%
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================
     FILA INFERIOR: 2 TARJETAS ANALÍTICAS PRINCIPALES
     ======================================================== -->
<div class="row g-4 mb-4">
    <!-- Tarjeta Izquierda (col-lg-7): Ventas por tipo de lote -->
    <div class="col-12 col-lg-7">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <!-- Header de Tarjeta -->
            <div class="mb-4">
                <h2 class="h5 fw-bold text-dark mb-1">Ventas por tipo de lote</h2>
                <p class="text-muted small mb-0">Participación en ingresos del periodo.</p>
            </div>

            <!-- Lista de Barras de Progreso Horizontales -->
            <div class="d-flex flex-column justify-content-around flex-grow-1" id="contenedorVentasTipoLote">
                <div id="estadoCargaReportes" class="text-center py-4 text-muted small">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Cargando indicadores...
                </div>
            </div>

            <!-- Nota al pie informativa -->
            <div class="border-top border-light-subtle pt-3 mt-3 d-flex justify-content-between align-items-center small text-muted">
                <span>Total ingresos registrados</span>
                <span class="fw-bold text-dark sf-money" id="totalIngresosReportes">—</span>
            </div>
        </div>
    </div>

    <!-- Tarjeta Derecha (col-lg-5): Meta mensual -->
    <div class="col-12 col-lg-5">
        <div class="bg-white rounded-4 shadow-sm border p-4 h-100 d-flex flex-column justify-content-between">
            <!-- Header de Tarjeta -->
            <div class="mb-3">
                <h2 class="h5 fw-bold text-dark mb-1">Meta mensual</h2>
                <p class="text-muted small mb-0" id="subtituloMetaMensual">Avance comercial del periodo.</p>
            </div>

            <!-- Gráfica de Dona Circular -->
            <div class="d-flex justify-content-center my-3">
                <div class="sf-donut-meta position-relative rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                     id="donutMetaMensual"
                     role="img"
                     aria-label="Avance de meta mensual"
                     style="width: 154px; height: 154px; background: conic-gradient(#2D4224 0% 0%, #E5E0D8 0% 100%);">
                    <!-- Agujero interior blanco de la dona -->
                    <div class="bg-white rounded-circle d-flex flex-column align-items-center justify-content-center shadow-sm"
                         style="width: 106px; height: 106px;">
                        <span class="display-5 fw-bold text-dark sf-money lh-1" id="kpiMetaPorcentaje">—</span>
                        <span class="small text-muted fw-semibold mt-1" style="font-size: 0.75rem;">de la meta</span>
                    </div>
                </div>
            </div>

            <!-- Métricas de Resumen Inferiores -->
            <div class="border-top border-light-subtle pt-3 mt-3">
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted small">Acumulado</span>
                    <span class="fw-bold text-success sf-money fs-6" id="kpiMetaAcumulado">—</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-1">
                    <span class="text-muted small">Objetivo mensual</span>
                    <span class="fw-bold text-dark sf-money fs-6" id="kpiMetaObjetivo">—</span>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<style>
    /* Estilos auxiliares para la vista de Reportes y Analítica */
    .sf-donut-meta {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .sf-donut-meta:hover {
        transform: scale(1.03);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
    }
</style>

@section Scripts {
    <script src="~/js/api/reportesApi.js" asp-append-version="true"></script>
    <script src="~/js/pages/reportesPage.js" asp-append-version="true"></script>
}
