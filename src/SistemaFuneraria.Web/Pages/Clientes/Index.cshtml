@page "/Clientes"
@model SistemaFuneraria.Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes - Relaciones";
}

<!-- Encabezado de Página -->
<div class="serenia-page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="serenia-kicker text-uppercase fw-bold">RELACIONES</span>
        <h1 class="serenia-page-title mb-1">Clientes</h1>
        <p class="serenia-page-subtitle text-muted mb-0">Expedientes, datos de contacto y contratos asociados.</p>
    </div>
    <div>
        <button type="button" 
                class="btn btn-serenia-primary" 
                data-bs-toggle="modal" 
                data-bs-target="#modalNuevoCliente">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
            <span>Nuevo cliente</span>
        </button>
    </div>
</div>

<!-- Barra de Herramientas: Búsqueda Reactiva y Exportar Directorio -->
<div class="serenia-toolbar mb-4">
    <div class="serenia-search-box flex-grow-1">
        <i class="fa-solid fa-magnifying-glass serenia-search-icon" aria-hidden="true"></i>
        <input type="text" 
               id="inputBuscarClientes" 
               class="form-control serenia-search-input" 
               placeholder="Buscar por nombre, teléfono o CURP" 
               autocomplete="off" 
               aria-label="Buscar clientes" />
    </div>
    <div>
        <button type="button" 
                class="btn-exportar-directorio" 
                id="btnExportarDirectorio"
                title="Exportar directorio de clientes">
            <i class="fa-solid fa-file-arrow-up me-1" aria-hidden="true"></i>
            <span>Exportar directorio</span>
        </button>
    </div>
</div>

