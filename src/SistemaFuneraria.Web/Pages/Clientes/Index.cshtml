@page "/Clientes"
@model SistemaFuneraria.Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes - Relaciones";
}

<div class="funeraria-page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="funeraria-kicker">RELACIONES</span>
        <h1 class="funeraria-page-title mb-1">Clientes</h1>
        <p class="funeraria-page-subtitle mb-0">Expedientes, datos de contacto y contratos asociados.</p>
    </div>
    <div>
        <button type="button" 
                class="btn btn-funeraria-primary" 
                data-bs-toggle="modal" 
                data-bs-target="#modalNuevoCliente">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Nuevo cliente</span>
        </button>
    </div>
</div>

@* Modal Reutilizable de Registro de Clientes (SF-019) *@
<partial name="_NuevoClienteModal" />
