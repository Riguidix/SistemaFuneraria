@* Modal Reutilizable de Registro de Clientes (SF-019) *@
<partial name="_NuevoClienteModal" />
@* Modal Reutilizable de Registro de Pago (Ticket 036) *@
<partial name="_RegistrarPagoModal" />

@section Scripts {
    <script>
        // Data Table Controller: Búsqueda, Filtros de Estado y Ordenamiento (Checklist.design)
        document.addEventListener('DOMContentLoaded', function () {
            var inputBuscar = document.getElementById('inputBuscarClientes');
            var btnClear = document.getElementById('btnClearSearch');
            var btnReset = document.getElementById('btnRestablecerFiltros');
            var tbody = document.getElementById('tbodyClientes');
            var filaVacia = document.getElementById('filaSinResultados');
            var contadorResultados = document.getElementById('contadorResultados');
            var pagDesde = document.getElementById('pagDesde');
            var pagHasta = document.getElementById('pagHasta');
            var pagTotal = document.getElementById('pagTotal');
            var filterPills = document.querySelectorAll('.filter-pill');
            var sortHeaders = document.querySelectorAll('.th-sortable');

            if (!inputBuscar || !tbody) return;

            var estadoFiltroActivo = 'todos';
            var ordenActual = { columna: null, ascendente: true };

            function aplicarFiltros() {
                var termino = inputBuscar.value.toLowerCase().trim();
                btnClear.style.display = termino.length > 0 ? 'block' : 'none';

                var filas = tbody.querySelectorAll('tr:not(#filaSinResultados)');
                var visibles = 0;

                filas.forEach(function (fila) {
                    var textoFila = fila.textContent.toLowerCase();
                    var curp = (fila.getAttribute('data-curp') || '').toLowerCase();
                    var estadoFila = (fila.getAttribute('data-estado') || '').toLowerCase();

                    var coincideTexto = termino === '' || textoFila.indexOf(termino) > -1 || curp.indexOf(termino) > -1;
                    var coincideEstado = estadoFiltroActivo === 'todos' || estadoFila === estadoFiltroActivo;

                    if (coincideTexto && coincideEstado) {
                        fila.style.display = '';
                        visibles++;
                    } else {
                        fila.style.display = 'none';
                    }
                });

                if (filaVacia) {
                    filaVacia.style.display = visibles === 0 ? '' : 'none';
                }

                // Actualizar contadores
                if (contadorResultados) {
                    contadorResultados.textContent = 'Mostrando ' + visibles + ' de ' + filas.length + ' clientes';
                }
                if (pagDesde && pagHasta && pagTotal) {
                    pagDesde.textContent = visibles > 0 ? '1' : '0';
                    pagHasta.textContent = visibles;
                    pagTotal.textContent = visibles;
                }
            }

            // Evento Input en buscador
            inputBuscar.addEventListener('input', aplicarFiltros);

            // Botón Limpiar búsqueda
            if (btnClear) {
                btnClear.addEventListener('click', function () {
                    inputBuscar.value = '';
                    inputBuscar.focus();
                    aplicarFiltros();
                });
            }

            // Botón Restablecer filtros en empty state (SF-037)
            if (btnReset) {
                btnReset.addEventListener('click', function () {
                    inputBuscar.value = '';
                    estadoFiltroActivo = 'todos';
                    filterPills.forEach(function (pill) {
                        var isTodos = pill.getAttribute('data-filter') === 'todos';
                        pill.classList.toggle('active', isTodos);
                        pill.setAttribute('aria-pressed', isTodos ? 'true' : 'false');
                    });
                    aplicarFiltros();
                });
            }

            // Exportación a CSV con BOM UTF-8 y Feedback Visual (Ticket SF-037)
            var btnExportar = document.getElementById('btnExportarDirectorio');
            if (btnExportar) {
                btnExportar.addEventListener('click', function () {
                    var btn = this;
                    var originalHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> <span>Exportando...</span>';

                    setTimeout(function () {
                        try {
                            var filasVisibles = Array.from(tbody.querySelectorAll('tr:not(#filaSinResultados):not(.skeleton-row)'))
                                .filter(function (r) { return r.style.display !== 'none'; });

                            var BOM = '\uFEFF';
                            var csv = BOM + 'Cliente,Teléfono,CURP,Contratos,Saldo,Último Pago,Estado\r\n';

                            filasVisibles.forEach(function (fila) {
                                var nombreEl = fila.querySelector('.nombre-cliente');
                                var nombre = nombreEl ? nombreEl.textContent.trim() : '';

                                var celdas = fila.querySelectorAll('td');
                                var contactoEl = celdas[1] ? celdas[1].querySelector('.text-dark') : null;
                                var telefono = contactoEl ? contactoEl.textContent.trim() : '';

                                var curp = fila.getAttribute('data-curp') || '';
                                var contratos = celdas[2] ? celdas[2].textContent.trim() : '';
                                var saldo = celdas[3] ? celdas[3].textContent.trim() : '';
                                var ultimoPago = celdas[4] ? celdas[4].textContent.trim() : '';

                                var badgeEstado = fila.querySelector('.badge-estado');
                                var estado = badgeEstado ? badgeEstado.textContent.trim() : (fila.getAttribute('data-estado') || '');

                                function escapeCsv(val) {
                                    if (!val) return '';
                                    if (val.indexOf(',') > -1 || val.indexOf('"') > -1 || val.indexOf('\n') > -1 || val.indexOf('\r') > -1) {
                                        return '"' + val.replace(/"/g, '""') + '"';
                                    }
                                    return val;
                                }

                                csv += [
                                    escapeCsv(nombre),
                                    escapeCsv(telefono),
                                    escapeCsv(curp),
                                    escapeCsv(contratos),
                                    escapeCsv(saldo),
                                    escapeCsv(ultimoPago),
                                    escapeCsv(estado)
                                ].join(',') + '\r\n';
                            });

                            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                            var ahora = new Date();
                            var yyyy = ahora.getFullYear();
                            var mm = String(ahora.getMonth() + 1).padStart(2, '0');
                            var dd = String(ahora.getDate()).padStart(2, '0');
                            var filename = 'directorio_clientes_' + yyyy + mm + dd + '.csv';

                            var url = URL.createObjectURL(blob);
                            var a = document.createElement('a');
                            a.href = url;
                            a.download = filename;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);

                            btn.disabled = false;
                            btn.innerHTML = originalHtml;

                            // Feedback Toast
                            if (window.SfUi && typeof window.SfUi.showToast === 'function') {
                                window.SfUi.showToast({
                                    type: 'success',
                                    title: 'Directorio exportado',
                                    message: '✓ Directorio exportado con éxito (' + filasVisibles.length + ' clientes descargados)'
                                });
                            }
                        } catch (err) {
                            console.error('Error al exportar directorio a CSV:', err);
                            btn.disabled = false;
                            btn.innerHTML = originalHtml;
                            if (window.SfUi && typeof window.SfUi.showToast === 'function') {
                                window.SfUi.showToast({
                                    type: 'error',
                                    title: 'Error de exportación',
                                    message: 'No fue posible exportar el directorio. Intente nuevamente.'
                                });
                            }
                        }
                    }, 350);
                });
            }

            // Helper de Estado de Carga / Skeletons (SF-027 / SF-037)
            window.setClientesLoading = function (loading) {
                var skeletonRows = tbody.querySelectorAll('.skeleton-row');
                var dataRows = tbody.querySelectorAll('tr:not(#filaSinResultados):not(.skeleton-row)');

                skeletonRows.forEach(function (r) { r.style.display = loading ? '' : 'none'; });
                dataRows.forEach(function (r) { r.style.display = loading ? 'none' : ''; });

                if (!loading) {
                    aplicarFiltros();
                }
            };

            // Filtros rápidos por estado
            filterPills.forEach(function (pill) {
                pill.addEventListener('click', function () {
                    filterPills.forEach(function (p) { p.classList.remove('active'); });
                    this.classList.add('active');
                    estadoFiltroActivo = this.getAttribute('data-filter') || 'todos';
                    aplicarFiltros();
                });
            });

            // Ordenamiento interactivo por cabeceras (Checklist Design: Sorting)
            sortHeaders.forEach(function (th) {
                th.addEventListener('click', function () {
                    var col = this.getAttribute('data-sort-col');
                    if (ordenActual.columna === col) {
                        ordenActual.ascendente = !ordenActual.ascendente;
                    } else {
                        ordenActual.columna = col;
                        ordenActual.ascendente = true;
                    }

                    // Actualizar iconos de ordenación
                    sortHeaders.forEach(function (header) {
                        var icon = header.querySelector('.sort-icon');
                        if (icon) {
                            icon.className = 'fa-solid fa-sort sort-icon';
                        }
                    });
                    var currentIcon = this.querySelector('.sort-icon');
                    if (currentIcon) {
                        currentIcon.className = ordenActual.ascendente ? 'fa-solid fa-sort-up sort-icon text-dark' : 'fa-solid fa-sort-down sort-icon text-dark';
                    }

                    // Ordenar elementos en el DOM
                    var filasArray = Array.from(tbody.querySelectorAll('tr:not(#filaSinResultados)'));
                    filasArray.sort(function (a, b) {
                        var valorA = a.getAttribute('data-' + col) || '';
                        var valorB = b.getAttribute('data-' + col) || '';

                        if (col === 'saldo') {
                            var numA = parseFloat(valorA) || 0;
                            var numB = parseFloat(valorB) || 0;
                            return ordenActual.ascendente ? numA - numB : numB - numA;
                        }

                        return ordenActual.ascendente 
                            ? valorA.localeCompare(valorB, 'es', { numeric: true }) 
                            : valorB.localeCompare(valorA, 'es', { numeric: true });
                    });

                    filasArray.forEach(function (row) {
                        tbody.insertBefore(row, filaVacia);
                    });
                });
            });

            // Disparador del Modal de Pago desde el enlace "Abrir" de clientes
            document.querySelectorAll('.btn-abrir-cobro').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var folio = this.getAttribute('data-folio');
                    var cliente = this.getAttribute('data-cliente');
                    var cuota = this.getAttribute('data-cuota');

                    var inputFolio = document.getElementById('pagoFolioContrato');
                    var inputCliente = document.getElementById('pagoClienteTitular');
                    var inputCuota = document.getElementById('pagoCuotaLiquidar');

                    if (inputFolio) inputFolio.value = folio;
                    if (inputCliente) inputCliente.value = cliente;
                    if (inputCuota) inputCuota.value = cuota;

                    var modalEl = document.getElementById('modalRegistrarPago');
                    if (modalEl && window.bootstrap) {
                        var modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modalInstance.show();
                    }
                });
            });
        });
    </script>
}
