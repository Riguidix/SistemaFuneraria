@page "/Clientes"
@model SistemaFuneraria.Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes - Relaciones";
}

<!-- Encabezado de Página -->
<div class="funeraria-page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="funeraria-kicker text-uppercase fw-bold">RELACIONES</span>
        <h1 class="funeraria-page-title mb-1">Clientes</h1>
        <p class="funeraria-page-subtitle text-muted mb-0">Expedientes, datos de contacto y contratos asociados.</p>
    </div>
    <div>
        <button type="button" 
                class="btn btn-funeraria-primary btn-serenia-primary" 
                data-bs-toggle="modal" 
                data-bs-target="#modalNuevoCliente"
                style="background-color: #2D4224 !important; color: #FFFFFF !important; border: 1px solid #2D4224 !important; border-radius: 8px !important; font-weight: 600 !important; padding: 0.65rem 1.25rem !important; display: inline-flex !important; align-items: center !important; gap: 0.5rem !important;">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
            <span>Nuevo cliente</span>
        </button>
    </div>
</div>

<!-- Barra de Herramientas: Búsqueda Reactiva y Exportar Directorio -->
<div class="funeraria-toolbar mb-3">
    <div class="funeraria-search-box flex-grow-1">
        <i class="fa-solid fa-magnifying-glass funeraria-search-icon" aria-hidden="true"></i>
        <input type="text" 
               id="inputBuscarClientes" 
               class="form-control funeraria-search-input" 
               placeholder="Buscar por nombre, teléfono o CURP" 
               autocomplete="off" 
               aria-label="Buscar clientes" />
        <button type="button" id="btnClearSearch" class="btn-clear-search" aria-label="Limpiar búsqueda" title="Limpiar búsqueda">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
    <div>
        <button type="button" 
                class="btn-exportar-directorio" 
                id="btnExportarDirectorio"
                title="Exportar directorio de clientes">
            <i class="fa-solid fa-file-arrow-up me-1" aria-hidden="true"></i>
            <span>Exportar directorio</span>
        </button>
    </div>
</div>

<!-- Filtros Rápidos por Estado (Checklist Design: Filter Controls) -->
<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="funeraria-filter-pills" role="tablist" aria-label="Filtrar por estado">
        <button type="button" class="filter-pill active" data-filter="todos" aria-pressed="true">
            Todos <span class="badge bg-white text-dark ms-1 rounded-pill" id="badgeTotalTodos">4</span>
        </button>
        <button type="button" class="filter-pill" data-filter="al corriente" aria-pressed="false">
            Al corriente <span class="badge bg-success-subtle text-success ms-1 rounded-pill">2</span>
        </button>
        <button type="button" class="filter-pill" data-filter="pago vencido" aria-pressed="false">
            Pago vencido <span class="badge bg-danger-subtle text-danger ms-1 rounded-pill">1</span>
        </button>
        <button type="button" class="filter-pill" data-filter="en revisión" aria-pressed="false">
            En revisión <span class="badge bg-warning-subtle text-warning-emphasis ms-1 rounded-pill">1</span>
        </button>
    </div>
    <div class="text-muted small">
        <span id="contadorResultados">Mostrando 4 clientes</span>
    </div>
</div>

