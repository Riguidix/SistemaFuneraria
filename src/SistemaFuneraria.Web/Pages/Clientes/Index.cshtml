@page "/Clientes"
@model SistemaFuneraria.Web.Pages.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes - Relaciones";
}

<!-- Encabezado de Página -->
<div class="funeraria-page-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <span class="funeraria-kicker text-uppercase fw-bold">RELACIONES</span>
        <h1 class="funeraria-page-title mb-1">Clientes</h1>
        <p class="funeraria-page-subtitle text-muted mb-0">Expedientes, datos de contacto y contratos asociados.</p>
    </div>
    <div id="contenedorBtnNuevoCliente" data-roles="Administrador,Vendedor">
        <button type="button"
                id="btnAbrirNuevoCliente"
                class="btn btn-funeraria-primary btn-serenia-primary d-inline-flex align-items-center gap-2 text-nowrap"
                data-bs-toggle="modal"
                data-bs-target="#modalNuevoCliente"
                style="background-color: #2D4224 !important; color: #FFFFFF !important; border: 1px solid #2D4224 !important; border-radius: 8px !important; font-weight: 600 !important; padding: 0.65rem 1.25rem !important;">
            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>
            <span>Nuevo cliente</span>
        </button>
    </div>
</div>

<!-- Estado de Acceso Restringido (403 Forbidden) -->
<div id="clientesAccesoRestringido" class="card border-0 shadow-sm rounded-4 p-5 text-center mb-4 d-none" role="alert">
    <div class="py-3">
        <i class="fa-solid fa-lock fa-2x text-danger mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark mb-2">Acceso restringido (403)</h2>
        <p class="text-muted small mx-auto mb-3" style="max-width: 460px;">
            Tu rol actual no tiene permisos para consultar el directorio de clientes. Esta sección está disponible para <strong>Administrador</strong> y <strong>Vendedor</strong>.
        </p>
        <a id="btnVolver403Clientes" href="/Caja" class="btn btn-funeraria-primary rounded-3 px-4">
            <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Volver a mi inicio
        </a>
    </div>
</div>

<div id="clientesContenidoPrincipal">
    <!-- Barra de Herramientas: Búsqueda Reactiva y Exportar Directorio -->
    <div class="funeraria-toolbar mb-3">
        <div class="funeraria-search-box flex-grow-1">
            <i class="fa-solid fa-magnifying-glass funeraria-search-icon" aria-hidden="true"></i>
            <input type="text"
                   id="inputBuscarClientes"
                   class="form-control funeraria-search-input"
                   placeholder="Buscar por nombre, correo, teléfono o CURP"
                   autocomplete="off"
                   aria-label="Buscar clientes" />
            <button type="button" id="btnClearSearch" class="btn-clear-search" aria-label="Limpiar búsqueda" title="Limpiar búsqueda">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div>
            <button type="button"
                    class="btn-exportar-directorio"
                    id="btnExportarDirectorio"
                    title="Exportar directorio de clientes">
                <i class="fa-solid fa-file-arrow-up me-1" aria-hidden="true"></i>
                <span>Exportar directorio</span>
            </button>
        </div>
    </div>

    <!-- Filtros Rápidos por Estado -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="funeraria-filter-pills" role="group" aria-label="Filtrar por estado">
            <button type="button" class="filter-pill active" data-filter="todos" aria-pressed="true">
                Todos <span class="badge bg-white text-dark ms-1 rounded-pill" id="badgeTotalTodos">0</span>
            </button>
            <button type="button" class="filter-pill" data-filter="al corriente" aria-pressed="false">
                Al corriente <span class="badge bg-success-subtle text-success ms-1 rounded-pill" id="badgeTotalAlCorriente">0</span>
            </button>
            <button type="button" class="filter-pill" data-filter="pago vencido" aria-pressed="false">
                Pago vencido <span class="badge bg-danger-subtle text-danger ms-1 rounded-pill" id="badgeTotalPagoVencido">0</span>
            </button>
            <button type="button" class="filter-pill" data-filter="en revisión" aria-pressed="false">
                En revisión <span class="badge bg-warning-subtle text-warning-emphasis ms-1 rounded-pill" id="badgeTotalEnRevision">0</span>
            </button>
        </div>
        <div class="text-muted small">
            <span id="contadorResultados">Cargando clientes...</span>
        </div>
    </div>

    <!-- Card Contenedor: Data Table Funeraria -->
    <div class="funeraria-table-card card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table funeraria-table align-middle mb-0" id="tablaClientes" aria-label="Directorio de clientes">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4 th-sortable" data-sort-col="nombre" tabindex="0" role="button" aria-sort="none" title="Ordenar por Nombre">
                            CLIENTE <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                        </th>
                        <th scope="col">CONTACTO</th>
                        <th scope="col">CONTRATOS</th>
                        <th scope="col" class="text-end th-sortable" data-sort-col="saldo" tabindex="0" role="button" aria-sort="none" title="Ordenar por Saldo Actual">
                            SALDO ACTUAL <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                        </th>
                        <th scope="col" class="th-sortable" data-sort-col="fecha" tabindex="0" role="button" aria-sort="none" title="Ordenar por Fecha de Pago">
                            ÚLTIMO PAGO <i class="fa-solid fa-sort sort-icon" aria-hidden="true"></i>
                        </th>
                        <th scope="col">ESTADO</th>
                        <th scope="col" class="text-end pe-4"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody id="tbodyClientes">
                    <!-- Filas Skeleton de Carga (SF-027 / SF-037) -->
                    <tr class="skeleton-row">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-secondary-subtle placeholder-wave placeholder" style="width: 40px; height: 40px;" aria-hidden="true"></div>
                                <div class="w-75">
                                    <span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded mb-1 d-block"></span>
                                    <span class="placeholder col-5 bg-secondary-subtle placeholder-wave rounded small d-block"></span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="placeholder col-9 bg-secondary-subtle placeholder-wave rounded mb-1 d-block"></span>
                            <span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded small d-block"></span>
                        </td>
                        <td><span class="placeholder col-7 bg-secondary-subtle placeholder-wave rounded"></span></td>
                        <td class="text-end"><span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded d-inline-block"></span></td>
                        <td><span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded"></span></td>
                        <td><span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded-pill"></span></td>
                        <td class="text-end pe-4"><span class="placeholder col-5 bg-secondary-subtle placeholder-wave rounded-3"></span></td>
                    </tr>
                    <tr class="skeleton-row">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-secondary-subtle placeholder-wave placeholder" style="width: 40px; height: 40px;" aria-hidden="true"></div>
                                <div class="w-75">
                                    <span class="placeholder col-7 bg-secondary-subtle placeholder-wave rounded mb-1 d-block"></span>
                                    <span class="placeholder col-4 bg-secondary-subtle placeholder-wave rounded small d-block"></span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded mb-1 d-block"></span>
                            <span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded small d-block"></span>
                        </td>
                        <td><span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded"></span></td>
                        <td class="text-end"><span class="placeholder col-7 bg-secondary-subtle placeholder-wave rounded d-inline-block"></span></td>
                        <td><span class="placeholder col-7 bg-secondary-subtle placeholder-wave rounded"></span></td>
                        <td><span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded-pill"></span></td>
                        <td class="text-end pe-4"><span class="placeholder col-5 bg-secondary-subtle placeholder-wave rounded-3"></span></td>
                    </tr>
                    <tr class="skeleton-row">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-secondary-subtle placeholder-wave placeholder" style="width: 40px; height: 40px;" aria-hidden="true"></div>
                                <div class="w-75">
                                    <span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded mb-1 d-block"></span>
                                    <span class="placeholder col-5 bg-secondary-subtle placeholder-wave rounded small d-block"></span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="placeholder col-9 bg-secondary-subtle placeholder-wave rounded mb-1 d-block"></span>
                            <span class="placeholder col-5 bg-secondary-subtle placeholder-wave rounded small d-block"></span>
                        </td>
                        <td><span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded"></span></td>
                        <td class="text-end"><span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded d-inline-block"></span></td>
                        <td><span class="placeholder col-8 bg-secondary-subtle placeholder-wave rounded"></span></td>
                        <td><span class="placeholder col-6 bg-secondary-subtle placeholder-wave rounded-pill"></span></td>
                        <td class="text-end pe-4"><span class="placeholder col-5 bg-secondary-subtle placeholder-wave rounded-3"></span></td>
                    </tr>

                    <!-- Estado Vacío / Empty State -->
                    <tr id="filaSinResultados" style="display: none;">
                        <td colspan="7" class="text-center py-5">
                            <div class="py-4">
                                <i class="fa-solid fa-magnifying-glass fa-2x text-muted mb-2" aria-hidden="true"></i>
                                <h6 class="fw-bold text-dark mb-1">No se encontraron clientes</h6>
                                <p class="text-muted small mb-3">No hay registros que coincidan con el término de búsqueda o filtro seleccionado.</p>
                                <button type="button" id="btnRestablecerFiltros" class="btn btn-sm btn-outline-secondary rounded-3">
                                    <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i> Restablecer filtros
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Estado de Error al cargar clientes -->
                    <tr id="filaErrorClientes" style="display: none;">
                        <td colspan="7" class="text-center py-5">
                            <div class="py-3">
                                <i class="fa-solid fa-circle-exclamation fa-2x text-danger mb-2" aria-hidden="true"></i>
                                <h6 class="fw-bold text-dark mb-1">No fue posible cargar el directorio</h6>
                                <p id="mensajeErrorClientes" class="text-muted small mb-3">Ocurrió un error al consultar la API.</p>
                                <button type="button" id="btnReintentarClientes" class="btn btn-sm btn-outline-danger rounded-3 px-3">
                                    <i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i> Reintentar
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Paginación y Resumen de Registros -->
        <div class="funeraria-table-footer">
            <div class="table-pagination-info">
                Mostrando <strong id="pagDesde">0</strong> a <strong id="pagHasta">0</strong> de <strong id="pagTotal">0</strong> clientes
            </div>
            <nav aria-label="Navegación de páginas de clientes">
                <ul class="funeraria-pagination" id="paginacionClientes">
                    <li>
                        <button type="button" class="page-btn disabled" aria-label="Página anterior" title="Página anterior" disabled>
                            <i class="fa-solid fa-chevron-left small" aria-hidden="true"></i>
                        </button>
                    </li>
                    <li>
                        <button type="button" class="page-btn active" aria-current="page">1</button>
                    </li>
                    <li>
                        <button type="button" class="page-btn disabled" aria-label="Página siguiente" title="Página siguiente" disabled>
                            <i class="fa-solid fa-chevron-right small" aria-hidden="true"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Drawer Lateral de Expediente, Edición y Eliminación Admin (SF-036) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="drawerExpedienteCliente" aria-labelledby="drawerClienteNombre" style="width: 460px; max-width: 100vw;">
    <div class="offcanvas-header border-bottom px-4 py-3">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar-funeraria" id="drawerClienteIniciales" aria-hidden="true">--</div>
            <div>
                <h2 class="offcanvas-title h5 fw-bold text-dark mb-0" id="drawerClienteNombre">Expediente del cliente</h2>
                <div class="text-muted small" id="drawerClienteFechaAlta">Cargando...</div>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body px-4 py-3">
        <div id="drawerClienteAlert" class="alert d-none rounded-3 small py-2 px-3 mb-3" role="alert"></div>

        <!-- Resumen de Cartera -->
        <div class="row g-2 mb-4">
            <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Contratos activos</div>
                    <div class="fw-bold text-dark" id="drawerClienteContratos">0 activos</div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Saldo actual</div>
                    <div class="fw-bold text-dark text-tabular" id="drawerClienteSaldo">$0.00</div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Último pago</div>
                    <div class="fw-semibold text-dark small" id="drawerClienteUltimoPago">Sin pagos</div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Estado</div>
                    <div class="mt-1">
                        <span class="badge badge-estado badge-al-corriente" id="drawerClienteEstado">Al corriente</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accesos Rápidos del Expediente -->
        <div class="d-flex gap-2 mb-4">
            <a id="btnDrawerNuevaVenta" href="/Ventas/Nueva" class="btn btn-sm btn-funeraria-primary flex-grow-1 rounded-3 fw-semibold text-white text-decoration-none d-inline-flex align-items-center justify-content-center gap-1"
               style="background-color: var(--sf-primary-olive, #2D4224); border-color: var(--sf-primary-olive, #2D4224);">
                <i class="fa-solid fa-plus" aria-hidden="true"></i>
                <span>Nueva venta</span>
            </a>
            <a id="btnDrawerVerContratos" href="/Contratos" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-3 fw-semibold text-decoration-none d-inline-flex align-items-center justify-content-center gap-1">
                <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                <span>Ver contratos</span>
            </a>
        </div>

        <!-- Formulario de Edición -->
        <h3 class="h6 fw-bold text-dark mb-3">Datos personales y de contacto</h3>
        <form id="formEditarCliente" novalidate>
            <input type="hidden" id="drawerEditId" />
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="drawerEditNombre" class="form-label funeraria-form-label">Nombre(s)</label>
                    <input type="text" id="drawerEditNombre" class="form-control funeraria-input" required />
                </div>
                <div class="col-md-6">
                    <label for="drawerEditApellidos" class="form-label funeraria-form-label">Apellidos</label>
                    <input type="text" id="drawerEditApellidos" class="form-control funeraria-input" required />
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label for="drawerEditTelefono" class="form-label funeraria-form-label">Teléfono</label>
                    <input type="tel" id="drawerEditTelefono" class="form-control funeraria-input" maxlength="15" required />
                </div>
                <div class="col-md-6">
                    <label for="drawerEditCurp" class="form-label funeraria-form-label">CURP</label>
                    <input type="text" id="drawerEditCurp" class="form-control funeraria-input text-uppercase" maxlength="18" style="text-transform: uppercase;" required />
                </div>
            </div>
            <div class="mb-3">
                <label for="drawerEditCorreo" class="form-label funeraria-form-label">Correo electrónico</label>
                <input type="email" id="drawerEditCorreo" class="form-control funeraria-input" required />
            </div>
            <div class="mb-3">
                <label for="drawerEditDireccion" class="form-label funeraria-form-label">Dirección</label>
                <input type="text" id="drawerEditDireccion" class="form-control funeraria-input" required />
            </div>
            <div class="d-grid mb-4">
                <button type="submit" class="btn btn-funeraria-primary" id="btnGuardarEdicionCliente">Guardar cambios</button>
            </div>
        </form>

        <!-- Zona de Eliminación Exclusiva de Administrador -->
        <div id="zonaEliminarCliente" class="border-top pt-3" data-roles="Administrador">
            <div class="d-flex align-items-center justify-content-between gap-2">
                <div>
                    <div class="fw-semibold text-danger small">Zona administrativa</div>
                    <div class="text-muted small">Solo disponible si el cliente no tiene contratos.</div>
                </div>
                <button type="button" id="btnEliminarCliente" class="btn btn-sm btn-outline-danger rounded-3 px-3">
                    <i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i> Eliminar cliente
                </button>
            </div>
            <div id="panelConfirmarEliminacion" class="d-none mt-3 p-3 rounded-3 bg-danger-subtle border border-danger-subtle">
                <p class="small text-danger-emphasis mb-2 fw-semibold">¿Confirmas eliminar definitivamente este cliente?</p>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" id="btnCancelarEliminarCliente" class="btn btn-sm btn-light border rounded-3">Cancelar</button>
                    <button type="button" id="btnConfirmarEliminarCliente" class="btn btn-sm btn-danger rounded-3">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Modal Reutilizable de Registro de Clientes (SF-035) *@
<partial name="_NuevoClienteModal" />

@section Scripts {
    <script src="~/js/api/clientesApi.js" asp-append-version="true"></script>
    <script src="~/js/pages/clientesPage.js" asp-append-version="true"></script>
}
