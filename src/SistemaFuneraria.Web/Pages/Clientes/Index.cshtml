@* Modal Reutilizable de Registro de Clientes (SF-019) *@
<partial name="_NuevoClienteModal" />

@section Scripts {
    <script>
        // Filtrado reactivo en tiempo real del lado cliente (SF-020)
        document.addEventListener('DOMContentLoaded', function () {
            var inputBuscar = document.getElementById('inputBuscarClientes');
            var tabla = document.getElementById('tablaClientes');
            if (!inputBuscar || !tabla) return;

            var filas = tabla.querySelectorAll('tbody tr:not(#filaSinResultados)');
            var filaVacia = document.getElementById('filaSinResultados');

            inputBuscar.addEventListener('input', function () {
                var termino = this.value.toLowerCase().trim();
                var visibles = 0;

                filas.forEach(function (fila) {
                    var contenidoTexto = fila.textContent.toLowerCase();
                    var curp = (fila.getAttribute('data-curp') || '').toLowerCase();
                    var coincide = contenidoTexto.indexOf(termino) > -1 || curp.indexOf(termino) > -1;

                    if (coincide) {
                        fila.style.display = '';
                        visibles++;
                    } else {
                        fila.style.display = 'none';
                    }
                });

                if (filaVacia) {
                    filaVacia.style.display = visibles === 0 ? '' : 'none';
                }
            });
        });
    </script>
}
