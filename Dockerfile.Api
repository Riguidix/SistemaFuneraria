FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/SistemaFuneraria.Core/SistemaFuneraria.Core.csproj src/SistemaFuneraria.Core/
COPY src/SistemaFuneraria.Application/SistemaFuneraria.Application.csproj src/SistemaFuneraria.Application/
COPY src/SistemaFuneraria.Infrastructure/SistemaFuneraria.Infrastructure.csproj src/SistemaFuneraria.Infrastructure/
COPY src/SistemaFuneraria.Api/SistemaFuneraria.Api.csproj src/SistemaFuneraria.Api/

RUN dotnet restore src/SistemaFuneraria.Api/SistemaFuneraria.Api.csproj

COPY src/SistemaFuneraria.Core/ src/SistemaFuneraria.Core/
COPY src/SistemaFuneraria.Application/ src/SistemaFuneraria.Application/
COPY src/SistemaFuneraria.Infrastructure/ src/SistemaFuneraria.Infrastructure/
COPY src/SistemaFuneraria.Api/ src/SistemaFuneraria.Api/

RUN dotnet publish src/SistemaFuneraria.Api/SistemaFuneraria.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "SistemaFuneraria.Api.dll"]
